<UserControl x:Class="TidyUp.Controls.ConditionEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TidyUp.Models.Domain"
             xmlns:enums="clr-namespace:TidyUp.Models.Enums"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:automation="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- ConditionGroup (Nested Container) Template -->
        <DataTemplate DataType="{x:Type local:ConditionGroup}">
            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderBrush="{DynamicResource MaterialDesignPrimaryBrush}"
                    BorderThickness="3,1,1,1"
                    Padding="12"
                    Margin="0,4,0,8"
                    CornerRadius="6">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource MaterialDesignPrimaryBrush}"
                                CornerRadius="4"
                                Padding="8,4"
                                Margin="0,0,8,0">
                            <TextBlock Text="GROUP"
                                       Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                                       FontWeight="Bold"
                                       FontSize="11"/>
                        </Border>

                        <TextBlock Grid.Column="1" 
                                   Text="Match:" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,8,0"/>

                        <ComboBox Grid.Column="2"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding Operator}"
                                  AutomationProperties.Name="Group match logic"
                                  MinWidth="140">
                            <ComboBoxItem Content="All (AND)" Tag="{x:Static enums:LogicOperator.And}"/>
                            <ComboBoxItem Content="Any (OR)" Tag="{x:Static enums:LogicOperator.Or}"/>
                        </ComboBox>

                        <TextBlock Grid.Column="3"
                                   Text="{Binding Conditions.Count, StringFormat='({0} items)'}"
                                   Opacity="0.6"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>

                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Content="+ Condition"
                                    Command="{Binding DataContext.AddConditionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Height="28"
                                    Padding="8,0"
                                    Margin="0,0,4,0"/>
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Content="+ Group"
                                    Command="{Binding DataContext.AddGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Height="28"
                                    Padding="8,0"
                                    Margin="0,0,4,0"/>
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="Remove condition group"
                                    Foreground="{DynamicResource Win11ErrorBrush}"
                                    ToolTip="Remove this group"
                                    Width="28" Height="28">
                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="18" Height="18"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Nested Conditions ItemsControl -->
                    <ItemsControl ItemsSource="{Binding Conditions}" Margin="16,4,0,0"/>

                    <!-- Empty nested state -->
                    <TextBlock Text="No conditions in this group. Click '+ Condition' to add one."
                               Opacity="0.5"
                               FontStyle="Italic"
                               Margin="16,8,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Conditions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- FileNameCondition Template -->
        <DataTemplate DataType="{x:Type local:FileNameCondition}">
            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,0,8"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  SelectedValue="FileName"
                                  SelectedValuePath="Tag"
                                  SelectionChanged="ConditionType_SelectionChanged"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Condition target type"
                                  Margin="0,0,8,0">
                            <ComboBoxItem Content="File Name" Tag="FileName"/>
                            <ComboBoxItem Content="Extension" Tag="Extension"/>
                            <ComboBoxItem Content="File Size" Tag="Size"/>
                            <ComboBoxItem Content="File Date" Tag="Date"/>
                        </ComboBox>
                        <ComboBox Grid.Column="1" 
                                  SelectedItem="{Binding Operator}"
                                  ItemsSource="{Binding Source={x:Static local:FileNameCondition.AvailableOperators}}"
                                  AutomationProperties.Name="File name operator"
                                  Margin="0,0,8,0"/>
                        <TextBox Grid.Column="2" 
                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Value or Regex Pattern"
                                 AutomationProperties.Name="File name value"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="3"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="Remove condition"
                                ToolTip="Remove">
                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                        </Button>
                    </Grid>
                    <!-- Regex validation error feedback -->
                    <StackPanel Grid.Row="1" 
                                Orientation="Horizontal" 
                                Margin="278,4,0,0"
                                Visibility="{Binding HasRegexError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <materialDesign:PackIcon Kind="AlertCircleOutline" 
                                                Foreground="{DynamicResource MaterialDesignValidationErrorBrush}" 
                                                Width="16" Height="16" 
                                                VerticalAlignment="Center" 
                                                Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding RegexErrorMessage, StringFormat='Invalid Regex: {0}'}" 
                                   Foreground="{DynamicResource MaterialDesignValidationErrorBrush}" 
                                   FontSize="11" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        
        <!-- FileExtensionCondition Template -->
        <DataTemplate DataType="{x:Type local:FileExtensionCondition}">
            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,0,8"
                    CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              SelectedValue="Extension"
                              SelectedValuePath="Tag"
                              SelectionChanged="ConditionType_SelectionChanged"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="Condition target type"
                              Margin="0,0,8,0">
                        <ComboBoxItem Content="File Name" Tag="FileName"/>
                        <ComboBoxItem Content="Extension" Tag="Extension"/>
                        <ComboBoxItem Content="File Size" Tag="Size"/>
                        <ComboBoxItem Content="File Date" Tag="Date"/>
                    </ComboBox>
                    <ComboBox Grid.Column="1" 
                              SelectedItem="{Binding Operator}"
                              ItemsSource="{Binding Source={x:Static local:FileExtensionCondition.AvailableOperators}}"
                              AutomationProperties.Name="Extension operator"
                              Margin="0,0,8,0"/>
                    <TextBox Grid.Column="2" 
                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="e.g. pdf, jpg, docx (without dot)"
                             AutomationProperties.Name="Extension value"
                             Margin="0,0,8,0"/>
                    <Button Grid.Column="3"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="Remove condition"
                            ToolTip="Remove">
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
        
        <!-- FileSizeCondition Template -->
        <DataTemplate DataType="{x:Type local:FileSizeCondition}">
            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,0,8"
                    CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              SelectedValue="Size"
                              SelectedValuePath="Tag"
                              SelectionChanged="ConditionType_SelectionChanged"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="Condition target type"
                              Margin="0,0,8,0">
                        <ComboBoxItem Content="File Name" Tag="FileName"/>
                        <ComboBoxItem Content="Extension" Tag="Extension"/>
                        <ComboBoxItem Content="File Size" Tag="Size"/>
                        <ComboBoxItem Content="File Date" Tag="Date"/>
                    </ComboBox>
                    <ComboBox Grid.Column="1" 
                              SelectedItem="{Binding Operator}"
                              ItemsSource="{Binding Source={x:Static local:FileSizeCondition.AvailableOperators}}"
                              AutomationProperties.Name="Size operator"
                              Margin="0,0,8,0"/>
                    <TextBox Grid.Column="2" 
                             Text="{Binding DisplaySize, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Size"
                             AutomationProperties.Name="Size value"
                             Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="3"
                              SelectedItem="{Binding SizeUnit}"
                              ItemsSource="{Binding Source={x:Static local:FileSizeCondition.AvailableUnits}}"
                              AutomationProperties.Name="Size unit"
                              Margin="0,0,8,0"/>
                    <Button Grid.Column="4"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="Remove condition"
                            ToolTip="Remove">
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
        
        <!-- FileDateCondition Template -->
        <DataTemplate DataType="{x:Type local:FileDateCondition}">
            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,0,8"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  SelectedValue="Date"
                                  SelectedValuePath="Tag"
                                  SelectionChanged="ConditionType_SelectionChanged"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Condition target type"
                                  Margin="0,0,8,0">
                            <ComboBoxItem Content="File Name" Tag="FileName"/>
                            <ComboBoxItem Content="Extension" Tag="Extension"/>
                            <ComboBoxItem Content="File Size" Tag="Size"/>
                            <ComboBoxItem Content="File Date" Tag="Date"/>
                        </ComboBox>
                        <ComboBox Grid.Column="1" 
                                  SelectedItem="{Binding Type}"
                                  ItemsSource="{Binding Source={x:Static local:FileDateCondition.AvailableDateTypes}}"
                                  AutomationProperties.Name="Date type"
                                  Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="2" 
                                  SelectedItem="{Binding Operator}"
                                  ItemsSource="{Binding Source={x:Static local:FileDateCondition.AvailableOperators}}"
                                  AutomationProperties.Name="Date operator"
                                  Margin="0,0,8,0"/>
                        <Button Grid.Column="4"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="Remove condition"
                                ToolTip="Remove">
                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                        </Button>
                    </Grid>
                    <!-- Context-sensitive Date / Days Editor -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="130,8,0,0">
                        <!-- Specific Date Picker -->
                        <DatePicker SelectedDate="{Binding Value}"
                                    materialDesign:HintAssist.Hint="Date"
                                    AutomationProperties.Name="Date value"
                                    MinWidth="150"
                                    Visibility="{Binding IsSpecificDate, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <!-- Between Max Date Picker -->
                        <DatePicker SelectedDate="{Binding MaxValue}"
                                    materialDesign:HintAssist.Hint="To Date"
                                    AutomationProperties.Name="Max date value"
                                    MinWidth="150"
                                    Margin="12,0,0,0"
                                    Visibility="{Binding IsBetween, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <!-- Older Than Days TextBox -->
                        <TextBox Text="{Binding DaysOld, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Days (e.g. 30)"
                                 AutomationProperties.Name="Days old"
                                 MinWidth="150"
                                 Visibility="{Binding IsOlderThanDays, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="200" MinHeight="100"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8">
            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding AddConditionCommand}"
                    automation:AutomationProperties.Name="Add condition"
                    ToolTip="Add condition to root group"
                    Margin="0,0,8,0">
                <Button.CommandParameter>
                    <Binding Path="RootCondition"/>
                </Button.CommandParameter>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="Add Condition" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                    Command="{Binding AddGroupCommand}"
                    automation:AutomationProperties.Name="Add condition group"
                    ToolTip="Add condition group"
                    Margin="0,0,8,0">
                <Button.CommandParameter>
                    <Binding Path="RootCondition"/>
                </Button.CommandParameter>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FolderPlus" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="Add Group" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Condition Tree -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <!-- Root Group Header -->
                <Border Background="{DynamicResource MaterialDesignDivider}"
                        Padding="12"
                        CornerRadius="4"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                  Text="Match:"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>

                        <ComboBox Grid.Column="1"
                                 SelectedValuePath="Tag"
                                 SelectedValue="{Binding RootCondition.Operator}"
                                 AutomationProperties.Name="Match logic"
                                 HorizontalAlignment="Left"
                                 MinWidth="150">
                            <ComboBoxItem Content="All of the following (AND)" Tag="{x:Static enums:LogicOperator.And}"/>
                            <ComboBoxItem Content="Any of the following (OR)" Tag="{x:Static enums:LogicOperator.Or}"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Conditions List -->
                <ItemsControl ItemsSource="{Binding RootCondition.Conditions}"
                             Margin="16,0,0,0"/>

                <!-- Empty State -->
                <TextBlock Text="No conditions defined. Click 'Add Condition' to start."
                          Opacity="0.6"
                          HorizontalAlignment="Center"
                          Margin="0,32">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RootCondition.Conditions.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <!-- Info -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,8">
            <materialDesign:PackIcon Kind="LightbulbOnOutline" Width="14" Height="14" 
                                    VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.7"/>
            <TextBlock Text="Conditions determine which files match this rule"
                      Opacity="0.7"
                      FontSize="11"/>
        </StackPanel>

        <!-- GridSplitter -->
        <GridSplitter Grid.Row="3" 
                     Height="4" 
                     HorizontalAlignment="Stretch"
                     Background="{DynamicResource MaterialDesignDivider}"
                     ResizeBehavior="PreviousAndNext"/>

        <!-- Live Preview Panel -->
        <Border Grid.Row="4" 
               BorderBrush="{DynamicResource MaterialDesignDivider}"
               BorderThickness="0,1,0,0"
               Background="{DynamicResource MaterialDesignCardBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" 
                       Background="{DynamicResource MaterialDesignDivider}" 
                       Padding="12,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Eye" 
                                                    Width="18" Height="18"
                                                    VerticalAlignment="Center" 
                                                    Margin="0,0,6,0"/>
                            <TextBlock Text="Live Preview" 
                                      FontSize="13" 
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MatchingFilesCount, StringFormat=' ({0} matches)'}"
                                      FontSize="12"
                                      Opacity="0.7"
                                      VerticalAlignment="Center"
                                      Margin="4,0,0,0"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                               Style="{StaticResource MaterialDesignRaisedButton}"
                               Command="{Binding RefreshPreviewCommand}"
                               AutomationProperties.Name="Refresh preview"
                               Height="28"
                               Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" 
                                                        Width="16" Height="16" 
                                                        VerticalAlignment="Center" 
                                                        Margin="0,0,4,0"/>
                                <TextBlock Text="Refresh" 
                                          VerticalAlignment="Center" 
                                          FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>

                <DataGrid Grid.Row="1"
                         ItemsSource="{Binding PreviewFiles}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         GridLinesVisibility="Horizontal"
                         HeadersVisibility="Column"
                         SelectionMode="Single"
                         Background="{DynamicResource MaterialDesignPaper}"
                         BorderThickness="0">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Matches}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Win11SuccessBackgroundBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Match" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <materialDesign:PackIcon Width="18" Height="18" 
                                                            HorizontalAlignment="Center">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="Close"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Win11TextSecondaryBrush}"/>
                                                <Setter Property="Opacity" Value="0.3"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Matches}" Value="True">
                                                        <Setter Property="Kind" Value="Check"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Win11SuccessBrush}"/>
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="File Name" 
                                           Binding="{Binding FileName}"
                                           Width="*"
                                           MinWidth="200"/>

                        <DataGridTextColumn Header="Path" 
                                           Binding="{Binding FolderPath}"
                                           Width="2*"
                                           MinWidth="250"/>

                        <DataGridTextColumn Header="Size" 
                                           Binding="{Binding FileSizeDisplay}"
                                           Width="80"/>

                        <DataGridTextColumn Header="Modified" 
                   Binding="{Binding ModifiedDate, StringFormat={}{0:MM/dd/yyyy}}"
                   Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Loading Indicator -->
                <Grid Grid.Row="1" 
                     Background="{DynamicResource MaterialDesignPaper}"
                     Opacity="0.9">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoadingPreview}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                    IsIndeterminate="True"
                                    Width="48" Height="48"/>
                        <TextBlock Text="Scanning files..." 
                                  FontSize="12"
                                  Opacity="0.7"
                                  HorizontalAlignment="Center"
                                  Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Empty State -->
                <TextBlock Grid.Row="1"
                          Text="No monitored folders configured. Add folders in the 'Folders' tab."
                          Opacity="0.6"
                          FontStyle="Italic"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMonitoredFolders}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
