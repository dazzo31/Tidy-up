<UserControl x:Class="TidyUp.Controls.ConditionEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TidyUp.Models.Domain"
             xmlns:enums="clr-namespace:TidyUp.Models.Enums"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:automation="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="200" MinHeight="100"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8">
            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="_Add Condition"
                    Command="{Binding AddConditionCommand}"
                    automation:AutomationProperties.Name="Add condition"
                    Margin="0,0,8,0">
                <Button.CommandParameter>
                    <Binding Path="RootCondition"/>
                </Button.CommandParameter>
            </Button>
            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="Add _Group"
                    Command="{Binding AddGroupCommand}"
                    automation:AutomationProperties.Name="Add condition group"
                    Margin="0,0,8,0">
                <Button.CommandParameter>
                    <Binding Path="RootCondition"/>
                </Button.CommandParameter>
            </Button>
        </StackPanel>

        <!-- Condition Tree -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <!-- Root Group Header -->
                <Border Background="{DynamicResource MaterialDesignDivider}"
                        Padding="12"
                        CornerRadius="4"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                  Text="Match:"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>

                        <ComboBox Grid.Column="1"
                                 SelectedValuePath="Tag"
                                 SelectedValue="{Binding RootCondition.Operator}"
                                 AutomationProperties.Name="Match logic"
                                 HorizontalAlignment="Left"
                                 MinWidth="150">
                            <ComboBoxItem Content="All of the following (AND)" Tag="And"/>
                            <ComboBoxItem Content="Any of the following (OR)" Tag="Or"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Conditions List -->
                <ItemsControl ItemsSource="{Binding RootCondition.Conditions}"
                             Margin="16,0,0,0">
                    <ItemsControl.Resources>
                        <!-- FileNameCondition Template -->
                        <DataTemplate DataType="{x:Type local:FileNameCondition}">
                            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                   BorderBrush="{DynamicResource MaterialDesignDivider}"
                                   BorderThickness="1"
                                   Padding="12"
                                   Margin="0,0,0,8"
                                   CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="File Name" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <ComboBox Grid.Column="1" 
                                             SelectedItem="{Binding Operator}"
                                             ItemsSource="{Binding Source={x:Type enums:StringOperator}, Converter={StaticResource EnumToItemsSourceConverter}}"
                                             AutomationProperties.Name="File name operator"
                                             Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="2" 
                                            Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                            materialDesign:HintAssist.Hint="Value"
                                            AutomationProperties.Name="File name value"
                                            Margin="0,0,8,0"/>
                                    <Button Grid.Column="3"
                                           Style="{StaticResource MaterialDesignIconButton}"
                                           Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           AutomationProperties.Name="Remove condition"
                                           ToolTip="Remove">
                                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        
                        <!-- FileExtensionCondition Template -->
                        <DataTemplate DataType="{x:Type local:FileExtensionCondition}">
                            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                   BorderBrush="{DynamicResource MaterialDesignDivider}"
                                   BorderThickness="1"
                                   Padding="12"
                                   Margin="0,0,0,8"
                                   CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Extension" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <ComboBox Grid.Column="1" 
                                             SelectedItem="{Binding Operator}"
                                             ItemsSource="{Binding Source={x:Type enums:StringOperator}, Converter={StaticResource EnumToItemsSourceConverter}}"
                                             AutomationProperties.Name="Extension operator"
                                             Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="2" 
                                            Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                            materialDesign:HintAssist.Hint="e.g., pdf, jpg, docx"
                                            AutomationProperties.Name="Extension value"
                                            Margin="0,0,8,0"/>
                                    <Button Grid.Column="3"
                                           Style="{StaticResource MaterialDesignIconButton}"
                                           Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           AutomationProperties.Name="Remove condition"
                                           ToolTip="Remove">
                                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        
                        <!-- FileSizeCondition Template -->
                        <DataTemplate DataType="{x:Type local:FileSizeCondition}">
                            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                   BorderBrush="{DynamicResource MaterialDesignDivider}"
                                   BorderThickness="1"
                                   Padding="12"
                                   Margin="0,0,0,8"
                                   CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="File Size" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <ComboBox Grid.Column="1" 
                                             SelectedItem="{Binding Operator}"
                                             ItemsSource="{Binding Source={x:Type local:FileSizeCondition}, Path=SizeOperator, Converter={StaticResource EnumToItemsSourceConverter}}"
                                             AutomationProperties.Name="Size operator"
                                             Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="2" 
                                            Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                            materialDesign:HintAssist.Hint="Size in bytes (e.g., 1024000 = 1MB)"
                                            AutomationProperties.Name="Size value"
                                            Margin="0,0,8,0"/>
                                    <Button Grid.Column="3"
                                           Style="{StaticResource MaterialDesignIconButton}"
                                           Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           AutomationProperties.Name="Remove condition"
                                           ToolTip="Remove">
                                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        
                        <!-- FileDateCondition Template -->
                        <DataTemplate DataType="{x:Type local:FileDateCondition}">
                            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                   BorderBrush="{DynamicResource MaterialDesignDivider}"
                                   BorderThickness="1"
                                   Padding="12"
                                   Margin="0,0,0,8"
                                   CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="File Date" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <ComboBox Grid.Column="1" 
                                                 SelectedItem="{Binding Type}"
                                                 ItemsSource="{Binding Source={x:Type local:FileDateCondition}, Path=DateType, Converter={StaticResource EnumToItemsSourceConverter}}"
                                                 AutomationProperties.Name="Date type"
                                                 Margin="0,0,8,0"/>
                                        <ComboBox Grid.Column="2" 
                                                 SelectedItem="{Binding Operator}"
                                                 ItemsSource="{Binding Source={x:Type local:FileDateCondition}, Path=DateOperator, Converter={StaticResource EnumToItemsSourceConverter}}"
                                                 AutomationProperties.Name="Date operator"
                                                 Margin="0,0,8,0"/>
                                        <Button Grid.Column="3"
                                               Style="{StaticResource MaterialDesignIconButton}"
                                               Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               AutomationProperties.Name="Remove condition"
                                               ToolTip="Remove">
                                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                                        </Button>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="120,8,0,0">
                                        <DatePicker SelectedDate="{Binding Value}"
                                                   materialDesign:HintAssist.Hint="Date"
                                                   AutomationProperties.Name="Date value"
                                                   MinWidth="150"/>
                                        <TextBox Text="{Binding DaysOld, UpdateSourceTrigger=PropertyChanged}"
                                                materialDesign:HintAssist.Hint="Days (for OlderThanDays)"
                                                AutomationProperties.Name="Days old"
                                                MinWidth="150"
                                                Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.Resources>
                </ItemsControl>

                <!-- Empty State -->
                <TextBlock Text="No conditions defined. Click 'Add Condition' to start."
                          Opacity="0.6"
                          HorizontalAlignment="Center"
                          Margin="0,32">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RootCondition.Conditions.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <!-- Info -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,8">
            <materialDesign:PackIcon Kind="LightbulbOnOutline" Width="14" Height="14" 
                                    VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.7"/>
            <TextBlock Text="Conditions determine which files match this rule"
                      Opacity="0.7"
                      FontSize="11"/>
        </StackPanel>

        <!-- GridSplitter -->
        <GridSplitter Grid.Row="3" 
                     Height="4" 
                     HorizontalAlignment="Stretch"
                     Background="{DynamicResource MaterialDesignDivider}"
                     ResizeBehavior="PreviousAndNext"/>

        <!-- Live Preview Panel -->
        <Border Grid.Row="4" 
               BorderBrush="{DynamicResource MaterialDesignDivider}"
               BorderThickness="0,1,0,0"
               Background="{DynamicResource MaterialDesignCardBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" 
                       Background="{DynamicResource MaterialDesignDivider}" 
                       Padding="12,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Eye" 
                                                    Width="18" Height="18"
                                                    VerticalAlignment="Center" 
                                                    Margin="0,0,6,0"/>
                            <TextBlock Text="Live Preview" 
                                      FontSize="13" 
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MatchingFilesCount, StringFormat=' ({0} matches)'}"
                                      FontSize="12"
                                      Opacity="0.7"
                                      VerticalAlignment="Center"
                                      Margin="4,0,0,0"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                               Style="{StaticResource MaterialDesignRaisedButton}"
                               Command="{Binding RefreshPreviewCommand}"
                               AutomationProperties.Name="Refresh preview"
                               Height="28"
                               Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" 
                                                        Width="16" Height="16" 
                                                        VerticalAlignment="Center" 
                                                        Margin="0,0,4,0"/>
                                <TextBlock Text="Refresh" 
                                          VerticalAlignment="Center" 
                                          FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>

                <DataGrid Grid.Row="1"
                         ItemsSource="{Binding PreviewFiles}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         GridLinesVisibility="Horizontal"
                         HeadersVisibility="All"
                         SelectionMode="Single">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Matches}" Value="True">
                                    <Setter Property="Background" Value="#E8F5E9"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Match" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <materialDesign:PackIcon Width="18" Height="18" 
                                                            HorizontalAlignment="Center">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="Close"/>
                                                <Setter Property="Foreground" Value="Gray"/>
                                                <Setter Property="Opacity" Value="0.3"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Matches}" Value="True">
                                                        <Setter Property="Kind" Value="Check"/>
                                                        <Setter Property="Foreground" Value="Green"/>
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="File Name" 
                                           Binding="{Binding FileName}"
                                           Width="*"
                                           MinWidth="200"/>

                        <DataGridTextColumn Header="Path" 
                                           Binding="{Binding FolderPath}"
                                           Width="2*"
                                           MinWidth="250"/>

                        <DataGridTextColumn Header="Size" 
                                           Binding="{Binding FileSizeDisplay}"
                                           Width="80"/>

                        <DataGridTextColumn Header="Modified" 
                   Binding="{Binding ModifiedDate, StringFormat={}{0:MM/dd/yyyy}}"
                   Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Loading Indicator -->
                <Grid Grid.Row="1" 
                     Background="{DynamicResource MaterialDesignPaper}"
                     Opacity="0.9">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoadingPreview}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                    IsIndeterminate="True"
                                    Width="48" Height="48"/>
                        <TextBlock Text="Scanning files..." 
                                  FontSize="12"
                                  Opacity="0.7"
                                  HorizontalAlignment="Center"
                                  Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Empty State -->
                <TextBlock Grid.Row="1"
                          Text="No monitored folders configured. Add folders in the 'Folders' tab."
                          Opacity="0.6"
                          FontStyle="Italic"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMonitoredFolders}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
