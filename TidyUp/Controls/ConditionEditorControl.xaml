<UserControl x:Class="TidyUp.Controls.ConditionEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TidyUp.Models.Domain"
             xmlns:enums="clr-namespace:TidyUp.Models.Enums"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8">
            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="Add Condition"
                    Command="{Binding AddConditionCommand}"
                    Margin="0,0,8,0">
                <Button.CommandParameter>
                    <Binding Path="RootCondition"/>
                </Button.CommandParameter>
            </Button>
            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="Add Group"
                    Command="{Binding AddGroupCommand}"
                    Margin="0,0,8,0">
                <Button.CommandParameter>
                    <Binding Path="RootCondition"/>
                </Button.CommandParameter>
            </Button>
        </StackPanel>

        <!-- Condition Tree -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <!-- Root Group Header -->
                <Border Background="{DynamicResource MaterialDesignDivider}"
                        Padding="12"
                        CornerRadius="4"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                  Text="Match:"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>

                        <ComboBox Grid.Column="1"
                                 SelectedValuePath="Tag"
                                 SelectedValue="{Binding RootCondition.Operator}"
                                 HorizontalAlignment="Left"
                                 MinWidth="150">
                            <ComboBoxItem Content="All of the following (AND)" Tag="And"/>
                            <ComboBoxItem Content="Any of the following (OR)" Tag="Or"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Conditions List -->
                <ItemsControl ItemsSource="{Binding RootCondition.Conditions}"
                             Margin="16,0,0,0">
                    <ItemsControl.Resources>
                        <!-- FileNameCondition Template -->
                        <DataTemplate DataType="{x:Type local:FileNameCondition}">
                            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                   BorderBrush="{DynamicResource MaterialDesignDivider}"
                                   BorderThickness="1"
                                   Padding="12"
                                   Margin="0,0,0,8"
                                   CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="File Name" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <ComboBox Grid.Column="1" 
                                             SelectedItem="{Binding Operator}"
                                             ItemsSource="{Binding Source={x:Type enums:StringOperator}, Converter={StaticResource EnumToItemsSourceConverter}}"
                                             Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="2" 
                                            Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                            materialDesign:HintAssist.Hint="Value"
                                            Margin="0,0,8,0"/>
                                    <Button Grid.Column="3"
                                           Style="{StaticResource MaterialDesignIconButton}"
                                           Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           ToolTip="Remove">
                                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        
                        <!-- FileExtensionCondition Template -->
                        <DataTemplate DataType="{x:Type local:FileExtensionCondition}">
                            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                   BorderBrush="{DynamicResource MaterialDesignDivider}"
                                   BorderThickness="1"
                                   Padding="12"
                                   Margin="0,0,0,8"
                                   CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Extension" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <ComboBox Grid.Column="1" 
                                             SelectedItem="{Binding Operator}"
                                             ItemsSource="{Binding Source={x:Type enums:StringOperator}, Converter={StaticResource EnumToItemsSourceConverter}}"
                                             Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="2" 
                                            Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                            materialDesign:HintAssist.Hint="e.g., pdf, jpg, docx"
                                            Margin="0,0,8,0"/>
                                    <Button Grid.Column="3"
                                           Style="{StaticResource MaterialDesignIconButton}"
                                           Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           ToolTip="Remove">
                                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        
                        <!-- FileSizeCondition Template -->
                        <DataTemplate DataType="{x:Type local:FileSizeCondition}">
                            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                   BorderBrush="{DynamicResource MaterialDesignDivider}"
                                   BorderThickness="1"
                                   Padding="12"
                                   Margin="0,0,0,8"
                                   CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="File Size" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <ComboBox Grid.Column="1" 
                                             SelectedItem="{Binding Operator}"
                                             ItemsSource="{Binding Source={x:Type local:FileSizeCondition+SizeOperator}, Converter={StaticResource EnumToItemsSourceConverter}}"
                                             Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="2" 
                                            Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                            materialDesign:HintAssist.Hint="Size in bytes (e.g., 1024000 = 1MB)"
                                            Margin="0,0,8,0"/>
                                    <Button Grid.Column="3"
                                           Style="{StaticResource MaterialDesignIconButton}"
                                           Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           ToolTip="Remove">
                                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        
                        <!-- FileDateCondition Template -->
                        <DataTemplate DataType="{x:Type local:FileDateCondition}">
                            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                   BorderBrush="{DynamicResource MaterialDesignDivider}"
                                   BorderThickness="1"
                                   Padding="12"
                                   Margin="0,0,0,8"
                                   CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="File Date" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <ComboBox Grid.Column="1" 
                                                 SelectedItem="{Binding Type}"
                                                 ItemsSource="{Binding Source={x:Type local:FileDateCondition+DateType}, Converter={StaticResource EnumToItemsSourceConverter}}"
                                                 Margin="0,0,8,0"/>
                                        <ComboBox Grid.Column="2" 
                                                 SelectedItem="{Binding Operator}"
                                                 ItemsSource="{Binding Source={x:Type local:FileDateCondition+DateOperator}, Converter={StaticResource EnumToItemsSourceConverter}}"
                                                 Margin="0,0,8,0"/>
                                        <Button Grid.Column="3"
                                               Style="{StaticResource MaterialDesignIconButton}"
                                               Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="Remove">
                                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                                        </Button>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="120,8,0,0">
                                        <DatePicker SelectedDate="{Binding Value}"
                                                   materialDesign:HintAssist.Hint="Date"
                                                   MinWidth="150"/>
                                        <TextBox Text="{Binding DaysOld, UpdateSourceTrigger=PropertyChanged}"
                                                materialDesign:HintAssist.Hint="Days (for OlderThanDays)"
                                                MinWidth="150"
                                                Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.Resources>
                </ItemsControl>

                <!-- Empty State -->
                <TextBlock Text="No conditions defined. Click 'Add Condition' to start."
                          Opacity="0.6"
                          HorizontalAlignment="Center"
                          Margin="0,32">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RootCondition.Conditions.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <!-- Info -->
        <TextBlock Grid.Row="2" 
                  Text="💡 Conditions determine which files match this rule"
                  Opacity="0.7"
                  FontSize="11"
                  Margin="16,8"/>
    </Grid>
</UserControl>
