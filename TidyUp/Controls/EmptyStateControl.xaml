<UserControl x:Class="TidyUp.Controls.EmptyStateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="450">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
            <!-- Icon Badge -->
            <Border x:Name="IconBadge"
                    Style="{DynamicResource AccessibleEmptyStateBadge}"
                    Margin="0,0,0,16">
                <materialDesign:PackIcon x:Name="IconGlyph"
                                        Kind="{Binding IconKind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Foreground="{DynamicResource Win11AccentBrush}"
                                        Width="32" Height="32"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Title -->
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Foreground="{DynamicResource Win11TextPrimaryBrush}"/>

            <!-- Description -->
            <TextBlock Text="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="13" TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" Margin="0,6,0,16"
                       LineHeight="18"
                       Foreground="{DynamicResource Win11TextSecondaryBrush}"/>

            <!-- Optional technical details (error variant) -->
            <Border x:Name="DetailsPanel" Visibility="Collapsed"
                    Background="{DynamicResource Win11CodeSurfaceBrush}"
                    BorderBrush="{DynamicResource Win11SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4" Padding="10,8" Margin="0,0,0,16"
                    HorizontalAlignment="Stretch">
                <TextBlock x:Name="DetailsText" FontSize="11" TextWrapping="Wrap"
                           FontFamily="Consolas, Cascadia Code, monospace"
                           Foreground="{DynamicResource Win11CodeTextBrush}"
                           MaxHeight="120"/>
            </Border>

            <!-- Optional Action Button -->
            <Button Content="{Binding ActionText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Command="{Binding ActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding ActionCommandParameter, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Visibility="{Binding ActionVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{DynamicResource AccessibleButton}"
                    HorizontalAlignment="Center"
                    Padding="16,6"/>

            <!-- Optional secondary action (error variant: copy details) -->
            <Button x:Name="SecondaryButton" Visibility="Collapsed"
                    Content="{Binding SecondaryActionText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Command="{Binding SecondaryActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    HorizontalAlignment="Center"
                    Margin="0,6,0,0"
                    Padding="12,4"
                    FontSize="12"/>
        </StackPanel>
    </Grid>
</UserControl>
