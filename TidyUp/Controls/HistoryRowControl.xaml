<UserControl x:Class="TidyUp.Controls.HistoryRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignWidth="950">

    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MaterialDesignDivider}" Padding="10,8">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Summary Line -->
                <RowDefinition Height="Auto"/>
                <!-- Expanded Detail Details -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 0: Summary Row -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <!-- Expand chevron -->
                    <ColumnDefinition Width="32"/>
                    <!-- Timestamp -->
                    <ColumnDefinition Width="145"/>
                    <!-- Action Badge -->
                    <ColumnDefinition Width="90"/>
                    <!-- Source Path -->
                    <ColumnDefinition Width="*"/>
                    <!-- Arrow -->
                    <ColumnDefinition Width="28"/>
                    <!-- Target Path -->
                    <ColumnDefinition Width="*"/>
                    <!-- Status Badge -->
                    <ColumnDefinition Width="95"/>
                    <!-- Action Buttons -->
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <!-- Expand Toggle Button -->
                <ToggleButton Grid.Column="0"
                              IsChecked="{Binding IsExpanded}"
                              Style="{StaticResource MaterialDesignFlatToggleButton}"
                              Width="26" Height="26" Margin="0" Padding="0"
                              ToolTip="Toggle Details">
                    <materialDesign:PackIcon Kind="ChevronRight" Width="20" Height="20">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="Kind" Value="ChevronDown"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                </ToggleButton>

                <!-- Timestamp -->
                <TextBlock Grid.Column="1"
                           Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                           VerticalAlignment="Center" FontSize="11" Opacity="0.8"/>

                <!-- Action Badge -->
                <Border Grid.Column="2"
                        Background="{Binding ActionBadgeBackground}"
                        CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ActionType}"
                               Foreground="{Binding ActionBadgeForeground}"
                               FontSize="10" FontWeight="Bold"/>
                </Border>

                <!-- Source Path -->
                <TextBlock Grid.Column="3"
                           Text="{Binding OriginalPath}"
                           VerticalAlignment="Center" FontSize="11"
                           TextTrimming="CharacterEllipsis" Margin="4,0"
                           ToolTip="{Binding OriginalPath}"/>

                <!-- Arrow -->
                <materialDesign:PackIcon Grid.Column="4" Kind="ArrowRight" Width="16" Height="16"
                                         VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5"/>

                <!-- Target Path -->
                <TextBlock Grid.Column="5"
                           Text="{Binding TargetPath, TargetNullValue='(none / deleted)'}"
                           VerticalAlignment="Center" FontSize="11"
                           TextTrimming="CharacterEllipsis" Margin="4,0"
                           ToolTip="{Binding TargetPath}"/>

                <!-- Status Badge -->
                <Border Grid.Column="6"
                        Background="{Binding StatusBadgeBackground}"
                        CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}"
                               Foreground="{Binding StatusBadgeForeground}"
                               FontSize="10" FontWeight="Bold"/>
                </Border>

                <!-- Quick Undo Button -->
                <Button Grid.Column="7"
                        Click="UndoOperation_Click"
                        IsEnabled="{Binding CanRollback}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Height="26" Padding="8,0" Margin="4,0,0,0"
                        ToolTip="Reverse this single operation">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Undo" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Undo" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 1: Expandable Details Panel -->
            <Border Grid.Row="1" Margin="32,8,0,4" Padding="12" CornerRadius="6"
                    Background="{DynamicResource MaterialDesignToolBarBackground}"
                    Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Rule & Identifiers -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding RuleName, StringFormat='Rule: {0}', TargetNullValue='Rule: (Manual / Unnamed)'}"
                                       FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding OperationId, StringFormat='Operation ID: {0}'}"
                                       FontSize="10" FontFamily="Consolas" Opacity="0.7"/>
                            <TextBlock Text="{Binding BatchId, StringFormat='Batch ID: {0}'}"
                                       FontSize="10" FontFamily="Consolas" Opacity="0.7"/>
                            <TextBlock Text="{Binding Details, StringFormat='Details: {0}', TargetNullValue='Details: None'}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Right Column: Integrity Hashes -->
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="File Integrity Checksums (SHA-256)" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding PreActionHash, StringFormat='Pre-Action:  {0}', TargetNullValue='Pre-Action:  (none)'}"
                                       FontSize="10" FontFamily="Consolas" Opacity="0.8"/>
                            <TextBlock Text="{Binding PostActionHash, StringFormat='Post-Action: {0}', TargetNullValue='Post-Action: (none)'}"
                                       FontSize="10" FontFamily="Consolas" Opacity="0.8"/>
                            <TextBlock Text="{Binding RolledBackAt, StringFormat='Rolled Back At: {0:yyyy-MM-dd HH:mm:ss}'}"
                                       FontSize="11" Foreground="#E65100" FontWeight="SemiBold" Margin="0,4,0,0"
                                       Visibility="{Binding RolledBackAt, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Rollback Status Message (if any) -->
                    <Border Grid.Row="1" Margin="0,8,0,0" Padding="8,4" CornerRadius="4" Background="#FFF3E0"
                            Visibility="{Binding RollbackMessage, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="{Binding RollbackMessage}" FontSize="11" Foreground="#E65100" FontWeight="SemiBold"/>
                    </Border>

                    <!-- Action Bar inside Expanded Row -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Click="UndoOperation_Click"
                                IsEnabled="{Binding CanRollback}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Height="28" Padding="12,0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Undo" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Undo Operation" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Click="UndoBatch_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="28" Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BackupRestore" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Undo Entire Batch" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

