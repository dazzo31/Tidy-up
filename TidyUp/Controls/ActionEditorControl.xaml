<UserControl x:Class="TidyUp.Controls.ActionEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TidyUp.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:domain="clr-namespace:TidyUp.Models.Domain"
             xmlns:enums="clr-namespace:TidyUp.Models.Enums"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar with Add Action Menu -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8">
            <Button x:Name="AddActionButton" 
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="AddActionButton_Click">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Add Action" VerticalAlignment="Center"/>
                </StackPanel>
                <Button.ContextMenu>
                    <ContextMenu x:Name="AddActionMenu">
                        <MenuItem Header="Move File" Command="{Binding AddMoveActionCommand}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="FolderMove"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copy File" Command="{Binding AddCopyActionCommand}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="ContentCopy"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Rename File" Command="{Binding AddRenameActionCommand}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="Rename"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Delete File" Command="{Binding AddDeleteActionCommand}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="Delete"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Change Extension" Command="{Binding AddChangeExtensionActionCommand}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="FileDocument"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </StackPanel>

        <!-- Actions List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Actions}" Margin="16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card Margin="0,0,0,12" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Order}" 
                                                  FontSize="18" 
                                                  FontWeight="Bold"
                                                  Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding Converter={StaticResource ActionTypeConverter}}" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <!-- Action buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                               Command="{Binding DataContext.MoveActionUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="Move Up">
                                            <materialDesign:PackIcon Kind="ArrowUp"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                               Command="{Binding DataContext.MoveActionDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="Move Down">
                                            <materialDesign:PackIcon Kind="ArrowDown"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                               Command="{Binding DataContext.RemoveActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="Remove">
                                            <materialDesign:PackIcon Kind="Delete"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Action Configuration -->
                                <ContentControl Grid.Row="1" Content="{Binding}" Margin="0,12,0,0">
                                    <ContentControl.Resources>
                                        <!-- Move Action Template -->
                                        <DataTemplate DataType="{x:Type domain:MoveFileAction}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="MoveDestinationTextBox"
                                                            Grid.Column="0"
                                                            Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}"
                                                            materialDesign:HintAssist.Hint="Destination Path (can use variables like {filename})"
                                                            Margin="0,0,4,0"/>
                                                    <Button Grid.Column="1"
                                                           Style="{StaticResource MaterialDesignIconButton}"
                                                           ToolTip="Insert Variable"
                                                           Click="InsertVariable_Click"
                                                           Tag="MoveDestinationTextBox"
                                                           Margin="0,0,4,0">
                                                        <materialDesign:PackIcon Kind="Variable" Width="20" Height="20"/>
                                                    </Button>
                                                    <Button Grid.Column="2"
                                                           Style="{StaticResource MaterialDesignIconButton}"
                                                           ToolTip="Browse for folder"
                                                           Click="BrowseDestinationFolder_Click"
                                                           Tag="{Binding}">
                                                        <materialDesign:PackIcon Kind="FolderOpen" Width="20" Height="20"/>
                                                    </Button>
                                                </Grid>
                                                <CheckBox Content="Preserve subfolder structure"
                                                         IsChecked="{Binding PreserveSubfolderStructure}"
                                                         Margin="0,0,0,8"/>
                                                <CheckBox Content="Remove empty source folders" 
                                                         IsChecked="{Binding RemoveEmptyFolders}"
                                                         Margin="0,0,0,8"/>
                                                <ComboBox materialDesign:HintAssist.Hint="If file exists"
                                                         SelectedItem="{Binding ConflictResolution}"
                                                         ItemsSource="{Binding Source={x:Type enums:ConflictResolution}, Converter={StaticResource EnumToItemsSourceConverter}}" />
                                            </StackPanel>
                                        </DataTemplate>

                                        <!-- Copy Action Template -->
                                        <DataTemplate DataType="{x:Type domain:CopyFileAction}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="CopyDestinationTextBox"
                                                            Grid.Column="0"
                                                            Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}"
                                                            materialDesign:HintAssist.Hint="Destination Path (can use variables like {filename})"
                                                            Margin="0,0,4,0"/>
                                                    <Button Grid.Column="1"
                                                           Style="{StaticResource MaterialDesignIconButton}"
                                                           ToolTip="Insert Variable"
                                                           Click="InsertVariable_Click"
                                                           Tag="CopyDestinationTextBox"
                                                           Margin="0,0,4,0">
                                                        <materialDesign:PackIcon Kind="Variable" Width="20" Height="20"/>
                                                    </Button>
                                                    <Button Grid.Column="2"
                                                           Style="{StaticResource MaterialDesignIconButton}"
                                                           ToolTip="Browse for folder"
                                                           Click="BrowseDestinationFolder_Click"
                                                           Tag="{Binding}">
                                                        <materialDesign:PackIcon Kind="FolderOpen" Width="20" Height="20"/>
                                                    </Button>
                                                </Grid>
                                                <CheckBox Content="Apply subsequent actions to source file"
                                                         IsChecked="{Binding ApplyToSourceFile}"
                                                         Margin="0,0,0,8"/>
                                            </StackPanel>
                                        </DataTemplate>

                                        <!-- Rename Action Template -->
                                        <DataTemplate DataType="{x:Type domain:RenameFileAction}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="RenamePatternTextBox"
                                                            Grid.Column="0"
                                                            Text="{Binding NamePattern, UpdateSourceTrigger=PropertyChanged}"
                                                            materialDesign:HintAssist.Hint="Name Pattern (e.g., {filename}_{date})"
                                                            Margin="0,0,4,0"/>
                                                    <Button Grid.Column="1"
                                                           Style="{StaticResource MaterialDesignIconButton}"
                                                           ToolTip="Insert Variable"
                                                           Click="InsertVariable_Click"
                                                           Tag="RenamePatternTextBox">
                                                        <materialDesign:PackIcon Kind="Variable" Width="20" Height="20"/>
                                                    </Button>
                                                </Grid>
                                                <TextBlock Text="💡 Click the variable button to insert variables"
                                                          Opacity="0.7"
                                                          FontSize="11"/>
                                            </StackPanel>
                                        </DataTemplate>

                                        <!-- Delete Action Template -->
                                        <DataTemplate DataType="{x:Type domain:DeleteFileAction}">
                                            <StackPanel>
                                                <CheckBox Content="Use Recycle Bin (recommended)" 
                                                         IsChecked="{Binding UseRecycleBin}"
                                                         Margin="0,0,0,8"/>
                                                <CheckBox Content="Remove empty parent folders" 
                                                         IsChecked="{Binding RemoveEmptyFolders}"
                                                         Margin="0,0,0,8"/>
                                                <CheckBox Content="Confirm before deleting" 
                                                         IsChecked="{Binding ConfirmBeforeDelete}"/>
                                            </StackPanel>
                                        </DataTemplate>

                                        <!-- Change Extension Template -->
                                        <DataTemplate DataType="{x:Type domain:ChangeExtensionAction}">
                                            <TextBox Text="{Binding NewExtension, UpdateSourceTrigger=PropertyChanged}"
                                                    materialDesign:HintAssist.Hint="New Extension (without dot)"/>
                                        </DataTemplate>
                                    </ContentControl.Resources>
                                </ContentControl>
                            </Grid>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty State -->
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Actions.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <TextBlock Text="No actions defined. Click 'Add Action' to start."
                      Opacity="0.6"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
        </Grid>

        <!-- Info -->
        <TextBlock Grid.Row="2" 
                  Text="💡 Actions are executed in order when a file matches"
                  Opacity="0.7"
                  FontSize="11"
                  Margin="16,8"/>
    </Grid>
</UserControl>
