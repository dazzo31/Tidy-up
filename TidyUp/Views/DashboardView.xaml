<UserControl x:Class="TidyUp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:TidyUp.Controls"
             xmlns:viewmodels="clr-namespace:TidyUp.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:DashboardViewModel}"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{DynamicResource MaterialDesignPaper}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Dashboard Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Operational Dashboard"
                               Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Real-time monitoring health, activity metrics, and folder automation status"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Opacity="0.7" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ScanAllFoldersCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0"
                            ToolTip="Scan all active monitored folders now">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderSync" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Scan All Folders" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding LoadDashboardDataCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Refresh Dashboard">
                        <materialDesign:PackIcon Kind="Refresh"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Metric Cards Row -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <controls:StatusCard Grid.Column="0" Margin="0,0,8,0"
                                     Title="Files Processed"
                                     Value="{Binding TotalFilesProcessed, StringFormat='{}{0:N0}'}"
                                     Subtitle="Organized across all rules"
                                     Icon="FileCheckOutline"
                                     IconForeground="{DynamicResource PrimaryHueMidBrush}"/>

                <controls:StatusCard Grid.Column="1" Margin="4,0,8,0"
                                     Title="Success Rate"
                                     Value="{Binding SuccessRateFormatted}"
                                     Subtitle="{Binding TotalErrors, StringFormat='{}{0} failure(s) logged'}"
                                     Icon="CheckCircleOutline"
                                     IconForeground="#2E7D32"/>

                <controls:StatusCard Grid.Column="2" Margin="4,0,8,0"
                                     Title="Active Rules"
                                     Value="{Binding ActiveRuleCount}"
                                     Subtitle="{Binding TotalRuleCount, StringFormat='of {0} configured rules'}"
                                     Icon="FilterOutline"
                                     IconForeground="#1976D2"/>

                <controls:StatusCard Grid.Column="3" Margin="8,0,0,0"
                                     Title="Monitored Folders"
                                     Value="{Binding MonitoredFolderCount}"
                                     Subtitle="{Binding LastActivityFormatted, StringFormat='Latest: {0}'}"
                                     Icon="FolderEyeOutline"
                                     IconForeground="#7B1FA2"/>
            </Grid>

            <!-- Main Content Area: Monitored Folders (Left) & Recent Activity (Right) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Monitored Folders -->
                <materialDesign:Card Grid.Column="0" Margin="0,0,12,0" Padding="16" UniformCornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Monitored Folders"
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Directories actively tracked by file system watchers"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                           Opacity="0.6"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Command="{Binding NavigateToRuleEditorCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Manage in Rules" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Empty State for Monitored Folders -->
                        <controls:EmptyStateControl Grid.Row="1"
                            IconKind="FolderEye"
                            Title="No Monitored Folders"
                            Description="No directories are currently monitored. Add folders to rules to track file events automatically."
                            ActionText="Manage in Rules"
                            ActionCommand="{Binding NavigateToRuleEditorCommand}"
                            Visibility="{Binding MonitoredFolders.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Zero}"
                            Margin="0,16"/>

                        <!-- Folders List -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding MonitoredFolders}"
                                      Visibility="{Binding MonitoredFolders.Count, Converter={StaticResource CountToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="12" CornerRadius="6"
                                            Background="{DynamicResource MaterialDesignToolBarBackground}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <materialDesign:PackIcon Grid.Column="0"
                                                                    Kind="Folder"
                                                                    Width="28" Height="28"
                                                                    Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,12,0"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               FontSize="14"/>
                                                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4"
                                                            Background="{Binding HealthBadgeBackground}" VerticalAlignment="Center"
                                                            ToolTip="{Binding HealthTooltip}">
                                                        <TextBlock Text="{Binding HealthStatusText}" FontSize="10" Foreground="{Binding HealthBadgeForeground}" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Border Margin="6,0,0,0" Padding="6,1" CornerRadius="4"
                                                            Background="#E8F5E9" VerticalAlignment="Center"
                                                            Visibility="{Binding IncludeSubfolders, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="Recursive" FontSize="10" Foreground="#2E7D32" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Path}"
                                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                           Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding AssociatedRules, StringFormat='Rules: {0}'}"
                                                           FontSize="11" Opacity="0.5" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Scan Now Button -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ProgressBar IsIndeterminate="True"
                                                             Width="20" Height="20"
                                                             Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                             Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                             Margin="0,0,8,0"/>
                                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        Padding="8,4" Height="32"
                                                        Command="{Binding DataContext.ScanFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Magnify" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Text="Scan" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </materialDesign:Card>

                <!-- Right Column: Recent Activity Feed -->
                <materialDesign:Card Grid.Column="1" Margin="12,0,0,0" Padding="16" UniformCornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Recent Activity"
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Live feed of actions executed by active rules"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                           Opacity="0.6"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Command="{Binding NavigateToLogsCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="All Logs" VerticalAlignment="Center"/>
                                    <materialDesign:PackIcon Kind="ChevronRight" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Empty State for Recent Activity -->
                        <controls:EmptyStateControl Grid.Row="1"
                            IconKind="History"
                            Title="No Recent Activity"
                            Description="Operations executed by active rules will appear here in real-time."
                            Visibility="{Binding RecentActivity.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Zero}"
                            Margin="0,16"/>

                        <!-- Activity Items -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="520"
                                      Visibility="{Binding RecentActivity.Count, Converter={StaticResource CountToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding RecentActivity}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="10" CornerRadius="6"
                                                Background="{DynamicResource MaterialDesignToolBarBackground}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <materialDesign:PackIcon Grid.Column="0"
                                                                        Kind="{Binding StatusIcon}"
                                                                        Foreground="{Binding StatusColor}"
                                                                        Width="20" Height="20"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,10,0"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                               Opacity="0.7">
                                                        <Run Text="{Binding ActionPerformed}"/>
                                                        <Run Text=" • "/>
                                                        <Run Text="{Binding RuleName}" FontWeight="SemiBold"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding RelativeTime}"
                                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                           Opacity="0.5"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

