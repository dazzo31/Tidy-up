<UserControl x:Class="TidyUp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel MaxWidth="700">
            
            <!-- General Settings -->
            <materialDesign:Card Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="General" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    
                    <TextBlock Text="Default Conflict Resolution" Margin="0,0,0,4" FontSize="12" Opacity="0.7"/>
                    <ComboBox ItemsSource="{Binding AvailableConflictStrategies}"
                              SelectedItem="{Binding Settings.DefaultConflictResolution}"
                              Margin="0,0,0,12"/>
                    
                    <TextBlock Text="Theme" Margin="0,0,0,4" FontSize="12" Opacity="0.7"/>
                    <ComboBox ItemsSource="{Binding AvailableThemes}"
                              SelectedItem="{Binding Settings.Theme}"
                              Margin="0,0,0,0"/>
                </StackPanel>
            </materialDesign:Card>
            
            <!-- Monitoring Settings -->
            <materialDesign:Card Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Monitoring" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    
                    <TextBlock Text="File Change Debounce Delay (ms)" Margin="0,0,0,4" FontSize="12" Opacity="0.7"/>
                    <TextBox Text="{Binding Settings.DebounceDelayMs, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Milliseconds"
                             Margin="0,0,0,4"/>
                    <TextBlock Text="Prevents rapid duplicate events. Default: 500ms" 
                               FontSize="11" Opacity="0.6" Margin="0,0,0,12"/>
                    
                    <TextBlock Text="Network Folder Polling Interval (seconds)" Margin="0,0,0,4" FontSize="12" Opacity="0.7"/>
                    <TextBox Text="{Binding Settings.NetworkFolderPollingIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Seconds"
                             Margin="0,0,0,4"/>
                    <TextBlock Text="How often to check network folders for changes. Default: 30s" 
                               FontSize="11" Opacity="0.6" Margin="0,0,0,12"/>
                    
                    <TextBlock Text="File Lock Retry Count" Margin="0,0,0,4" FontSize="12" Opacity="0.7"/>
                    <TextBox Text="{Binding Settings.FileLockRetryCount, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Attempts"
                             Margin="0,0,0,4"/>
                    <TextBlock Text="Number of times to retry locked files. Default: 3" 
                               FontSize="11" Opacity="0.6" Margin="0,0,0,12"/>
                    
                    <TextBlock Text="File Lock Retry Delay (ms)" Margin="0,0,0,4" FontSize="12" Opacity="0.7"/>
                    <TextBox Text="{Binding Settings.FileLockRetryDelayMs, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Milliseconds"
                             Margin="0,0,0,4"/>
                    <TextBlock Text="Delay between retry attempts. Default: 1000ms" 
                               FontSize="11" Opacity="0.6" Margin="0,0,0,0"/>
                </StackPanel>
            </materialDesign:Card>
            
            <!-- Logs Settings -->
            <materialDesign:Card Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Logs" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    
                    <TextBlock Text="Log Retention Period (days)" Margin="0,0,0,4" FontSize="12" Opacity="0.7"/>
                    <TextBox Text="{Binding Settings.LogRetentionDays, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Days"
                             Margin="0,0,0,4"/>
                    <TextBlock Text="Logs older than this will be deleted. Default: 30 days" 
                               FontSize="11" Opacity="0.6" Margin="0,0,0,12"/>
                    
                    <CheckBox IsChecked="{Binding Settings.AutoCleanupLogs}"
                              Content="Automatically cleanup old logs"
                              Margin="0,0,0,0"/>
                </StackPanel>
            </materialDesign:Card>
            
            <!-- Notification Settings -->
            <materialDesign:Card Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Notifications" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    
                    <CheckBox IsChecked="{Binding Settings.SystemTrayEnabled}"
                              Content="Enable system tray icon"
                              Margin="0,0,0,8"/>
                    
                    <CheckBox IsChecked="{Binding Settings.MinimizeToTray}"
                              Content="Minimize to system tray instead of taskbar"
                              Margin="0,0,0,8"/>
                    
                    <CheckBox IsChecked="{Binding Settings.ToastNotificationsEnabled}"
                              Content="Enable toast notifications"
                              Margin="0,0,0,8"/>
                    
                    <CheckBox IsChecked="{Binding Settings.ShowSuccessNotifications}"
                              Content="Show notifications for successful operations"
                              Margin="0,0,0,8"/>
                    
                    <CheckBox IsChecked="{Binding Settings.ShowErrorNotifications}"
                              Content="Show notifications for errors"
                              Margin="0,0,0,0"/>
                </StackPanel>
            </materialDesign:Card>
            
            <!-- Actions -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Reset to Defaults"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding ResetToDefaultsAsyncCommand}"
                        Margin="0,0,8,0"/>
                
                <Button Content="Save Settings"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding SaveSettingsAsyncCommand}"/>
            </StackPanel>
            
            <!-- Status Message -->
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Right"
                       Margin="0,8,0,0"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>
