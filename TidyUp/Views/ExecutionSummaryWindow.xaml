<Window x:Class="TidyUp.Views.ExecutionSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:TidyUp.ViewModels"
        xmlns:diagnostics="clr-namespace:TidyUp.Services.Diagnostics"
        mc:Ignorable="d"
        Title="Execution Summary &amp; Discrepancy Analyzer"
        Height="600" Width="850"
        MinHeight="450" MinWidth="650"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header Zone -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Summary Statistics Cards -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Filter Controls -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Discrepancy Items Grid -->
            <RowDefinition Height="*"/>
            <!-- 4: Footer Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0: Header Zone -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16,12">
            <materialDesign:ColorZone.Style>
                <Style TargetType="materialDesign:ColorZone">
                    <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDiscrepancies}" Value="True">
                            <Setter Property="Background" Value="#C62828"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </materialDesign:ColorZone.Style>
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="30" Height="30" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="Post-Execution Discrepancy Analyzer" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding SummaryText}" FontSize="12" Foreground="White" Opacity="0.9"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:ColorZone>

        <!-- 1: Summary Statistics Cards -->
        <Grid Grid.Row="1" Margin="16,12,16,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Planned Card -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,8,0" Padding="12,10" UniformCornerRadius="6">
                <StackPanel>
                    <TextBlock Text="Total Planned" FontSize="11" Opacity="0.6"/>
                    <TextBlock Text="{Binding TotalPlanned}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBlock Text="Simulated in preview" FontSize="10" Opacity="0.5"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Executed As Planned Card -->
            <materialDesign:Card Grid.Column="1" Margin="4,0,4,0" Padding="12,10" UniformCornerRadius="6">
                <StackPanel>
                    <TextBlock Text="Executed As Planned" FontSize="11" Opacity="0.6"/>
                    <TextBlock Text="{Binding ExecutedAsPlannedCount}" FontSize="22" FontWeight="Bold" Foreground="#2E7D32"/>
                    <TextBlock Text="Zero divergence" FontSize="10" Opacity="0.5"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Discrepancies Card -->
            <materialDesign:Card Grid.Column="2" Margin="8,0,0,0" Padding="12,10" UniformCornerRadius="6">
                <StackPanel>
                    <TextBlock Text="Discrepancies Detected" FontSize="11" Opacity="0.6"/>
                    <TextBlock Text="{Binding DiscrepancyCount}" FontSize="22" FontWeight="Bold" Foreground="#C62828"/>
                    <TextBlock Text="Locks, missing, or changed" FontSize="10" Opacity="0.5"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <!-- 2: Filter Controls -->
        <DockPanel Grid.Row="2" Margin="16,6,16,4" LastChildFill="False">
            <CheckBox Content="Show Discrepancies Only"
                      IsChecked="{Binding ShowDiscrepanciesOnly}"
                      VerticalAlignment="Center"
                      Style="{StaticResource MaterialDesignFilterChipCheckBox}"/>
        </DockPanel>

        <!-- 3: Discrepancy Items Grid -->
        <GroupBox Grid.Row="3" Margin="16,4,16,12" Header="Action Execution Audit"
                  Style="{StaticResource MaterialDesignCardGroupBox}">
            <DataGrid ItemsSource="{Binding DisplayItems}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <!-- Outcome Badge -->
                    <DataGridTemplateColumn Header="Outcome" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="8,2" CornerRadius="4" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E8F5E9"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static diagnostics:DiscrepancyOutcome.ModifiedSincePreview}">
                                                    <Setter Property="Background" Value="#FFF3E0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static diagnostics:DiscrepancyOutcome.SkippedDueToLock}">
                                                    <Setter Property="Background" Value="#FFF8E1"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static diagnostics:DiscrepancyOutcome.FailedDueToPermission}">
                                                    <Setter Property="Background" Value="#FFEBEE"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static diagnostics:DiscrepancyOutcome.FileDisappeared}">
                                                    <Setter Property="Background" Value="#FFEBEE"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static diagnostics:DiscrepancyOutcome.FailedGeneralError}">
                                                    <Setter Property="Background" Value="#FFEBEE"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static diagnostics:DiscrepancyOutcome.NotExecuted}">
                                                    <Setter Property="Background" Value="#F5F5F5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Outcome}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Outcome}" Value="{x:Static diagnostics:DiscrepancyOutcome.ModifiedSincePreview}">
                                                        <Setter Property="Foreground" Value="#E65100"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Outcome}" Value="{x:Static diagnostics:DiscrepancyOutcome.SkippedDueToLock}">
                                                        <Setter Property="Foreground" Value="#F57F17"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Outcome}" Value="{x:Static diagnostics:DiscrepancyOutcome.FailedDueToPermission}">
                                                        <Setter Property="Foreground" Value="#C62828"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Outcome}" Value="{x:Static diagnostics:DiscrepancyOutcome.FileDisappeared}">
                                                        <Setter Property="Foreground" Value="#C62828"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Outcome}" Value="{x:Static diagnostics:DiscrepancyOutcome.FailedGeneralError}">
                                                        <Setter Property="Foreground" Value="#C62828"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Outcome}" Value="{x:Static diagnostics:DiscrepancyOutcome.NotExecuted}">
                                                        <Setter Property="Foreground" Value="#757575"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Action Type -->
                    <DataGridTextColumn Header="Action" Binding="{Binding ActionType}" Width="80"/>

                    <!-- Source Path -->
                    <DataGridTextColumn Header="Source File" Binding="{Binding SourcePath}" Width="200"/>

                    <!-- Target Path -->
                    <DataGridTextColumn Header="Target Path" Binding="{Binding ActualTargetPath}" Width="160"/>

                    <!-- Explanation -->
                    <DataGridTextColumn Header="Diagnostic Details" Binding="{Binding Explanation}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- 4: Footer Actions -->
        <Border Grid.Row="4" Background="{DynamicResource MaterialDesignToolBarBackground}" Padding="16,10">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right"
                        Content="Close"
                        IsCancel="True"
                        Command="{Binding CloseCommand}"
                        Click="CloseButton_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

