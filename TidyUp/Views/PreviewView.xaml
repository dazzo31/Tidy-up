<UserControl x:Class="TidyUp.Views.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:TidyUp.Controls"
             xmlns:styles="clr-namespace:TidyUp.Styles"
             xmlns:viewmodels="clr-namespace:TidyUp.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:PreviewViewModel}"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header and Action Breakdown Badges -->
        <controls:PageHeader Grid.Row="0" Margin="0,0,0,12"
                             Title="Preview &amp; Review"
                             Subtitle="{Binding PlanHeaderInfo}">
            <!-- Operation Breakdown Summary Bar -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource Win11InfoBackgroundBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,6,0">
                    <TextBlock Text="{Binding MoveCount, StringFormat='Move: {0}'}" Foreground="{DynamicResource Win11InfoBrush}" FontWeight="SemiBold" FontSize="11"/>
                </Border>
                <Border Background="{DynamicResource Win11TealBackgroundBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,6,0">
                    <TextBlock Text="{Binding CopyCount, StringFormat='Copy: {0}'}" Foreground="{DynamicResource Win11TealBrush}" FontWeight="SemiBold" FontSize="11"/>
                </Border>
                <Border Background="{DynamicResource Win11PurpleBackgroundBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,6,0">
                    <TextBlock Text="{Binding RenameCount, StringFormat='Rename: {0}'}" Foreground="{DynamicResource Win11PurpleBrush}" FontWeight="SemiBold" FontSize="11"/>
                </Border>
                <Border Background="{DynamicResource Win11ErrorBackgroundBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,6,0">
                    <TextBlock Text="{Binding DeleteCount, StringFormat='Recycle: {0}'}" Foreground="{DynamicResource Win11ErrorBrush}" FontWeight="SemiBold" FontSize="11"/>
                </Border>
                <Border Background="{DynamicResource Win11WarningBackgroundBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                    <TextBlock Text="{Binding ConflictCount, StringFormat='Conflicts: {0}'}" Foreground="{DynamicResource Win11WarningBrush}" FontWeight="Bold" FontSize="11"/>
                </Border>
                <Button Command="{Binding RefreshPreviewCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Height="28" Padding="8,0" FontSize="11"
                        ToolTip="Refresh preview simulation against monitored folders"
                        AutomationProperties.Name="Refresh preview">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </controls:PageHeader>

        <!-- Warning Banner for Incomplete / Partial Scans -->
        <Border Grid.Row="1" Margin="0,0,0,12" Background="{DynamicResource Win11WarningBackgroundBrush}" BorderBrush="{DynamicResource Win11WarningBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8"
                Visibility="{Binding HasScanWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="{DynamicResource Win11WarningBrush}" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding ScanWarningMessage}" Foreground="{DynamicResource Win11WarningBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Filter & Control Toolbar -->
        <materialDesign:Card Grid.Row="2" Margin="0,0,0,12" Padding="10,6" UniformCornerRadius="6">
            <DockPanel>
                <!-- Quick Selection Controls -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Approve All" 
                            Command="{Binding ApproveAllCommand}" 
                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Height="28" Padding="8,0" Margin="0,0,6,0" FontSize="11"/>
                    <Button Content="Reject All" 
                            Command="{Binding RejectAllCommand}" 
                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Height="28" Padding="8,0" FontSize="11"/>
                </StackPanel>

                <!-- Search and Filters -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Search paths..."
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Width="220" Margin="0,0,10,0"
                             materialDesign:HintAssist.IsFloating="False"
                             AutomationProperties.Name="Search preview items"/>

                    <ComboBox ItemsSource="{Binding RuleFilterOptions}"
                              SelectedItem="{Binding SelectedRuleFilter}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Width="150" Margin="0,0,8,0"
                              materialDesign:HintAssist.Hint="Rule"
                              materialDesign:HintAssist.IsFloating="False"
                              AutomationProperties.HelpText="Show only operations from one rule"
                              AutomationProperties.Name="Filter by rule"/>

                    <ComboBox ItemsSource="{Binding ActionTypeFilterOptions}"
                              SelectedItem="{Binding SelectedActionTypeFilter}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Width="130" Margin="0,0,12,0"
                              materialDesign:HintAssist.Hint="Action type"
                              materialDesign:HintAssist.IsFloating="False"
                              AutomationProperties.HelpText="Show only one kind of operation"
                              AutomationProperties.Name="Filter by action type"/>

                    <CheckBox Content="Conflicts Only"
                              IsChecked="{Binding ShowConflictsOnly}"
                              Style="{StaticResource MaterialDesignCheckBox}"
                              FontSize="12" Margin="0,0,12,0"/>

                    <CheckBox Content="Deletions Only"
                              IsChecked="{Binding ShowDeletionsOnly}"
                              Style="{StaticResource MaterialDesignCheckBox}"
                              FontSize="12"/>
                </StackPanel>
            </DockPanel>
        </materialDesign:Card>

        <!-- Central Workspace with Side-by-Side DataGrid and Explainability Drawer -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Virtualized Planned Actions DataGrid -->
            <materialDesign:Card Grid.Column="0" UniformCornerRadius="8">
                <Grid>
                    <!-- Empty State -->
                    <controls:EmptyStateControl
                        IconKind="EyeCheckOutline"
                        Title="No Preview Data Available"
                        Description="No simulation plan has been executed. Select a rule or run preview from the Rules view."
                        Visibility="{Binding FilteredItems.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Zero}"
                        Margin="0,60"/>

                    <DataGrid ItemsSource="{Binding FilteredItems}"
                              SelectedItem="{Binding SelectedItem}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              Visibility="{Binding FilteredItems.Count, Converter={StaticResource CountToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <!-- Approved Checkbox -->
                            <DataGridTemplateColumn Header="Apply" Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsApproved, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanToggleApproval}"
                                                  HorizontalAlignment="Center"
                                                  AutomationProperties.Name="Approve planned action"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status Badge -->
                            <DataGridTemplateColumn Header="Status" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border styles:ThemeBrush.Background="{Binding StatusBadgeBackground}"
                                                CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="4">
                                            <TextBlock Text="{Binding StatusBadgeText}"
                                                       styles:ThemeBrush.Foreground="{Binding StatusBadgeForeground}"
                                                       FontWeight="Bold" FontSize="10"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Action Badge -->
                            <DataGridTemplateColumn Header="Action" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border styles:ThemeBrush.Background="{Binding ActionBadgeBackground}"
                                                CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="4">
                                            <TextBlock Text="{Binding ActionBadgeText}"
                                                       styles:ThemeBrush.Foreground="{Binding ActionBadgeForeground}"
                                                       FontWeight="SemiBold" FontSize="10"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Source File Path -->
                            <DataGridTextColumn Header="Original Source Path" 
                                                Binding="{Binding SourcePath}" 
                                                Width="*" MinWidth="220"/>

                            <!-- Proposed Target Path -->
                            <DataGridTextColumn Header="Target Destination" 
                                                Binding="{Binding TargetPath}" 
                                                Width="*" MinWidth="220"/>

                            <!-- Matching Rule -->
                            <DataGridTextColumn Header="Rule" 
                                                Binding="{Binding RuleName}" 
                                                Width="130"/>

                            <!-- Conflict Details -->
                            <DataGridTextColumn Header="Conflict Details" 
                                                Binding="{Binding ConflictDescription}" 
                                                Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>

            <!-- File-Level Explainability Side Drawer -->
            <Border Grid.Column="1" 
                    Width="320" 
                    Margin="12,0,0,0" 
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Visibility="{Binding IsExplainDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <!-- Drawer Header -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" 
                                Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding ToggleExplainDrawerCommand}"
                                Width="24" Height="24">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="Condition Inspector" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Text="Why did this file match the rule?" FontSize="11" Opacity="0.6"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Breakdown Content -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- File Summary Card -->
                            <Border Background="{DynamicResource MaterialDesignToolBarBackground}"
                                    CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Target File" FontSize="10" Opacity="0.6" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedItem.SourcePath}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedFileExplanation.MatchSummary}" FontSize="11" Opacity="0.8" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Breakdown Conditions List -->
                            <TextBlock Text="Evaluated Conditions:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding SelectedFileExplanation.ConditionResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                BorderThickness="0,0,0,1" Padding="0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Grid.Column="0" 
                                                                        Kind="CheckCircle"
                                                                        Foreground="{DynamicResource Win11SuccessBrush}" 
                                                                        Width="16" Height="16" 
                                                                        Margin="0,2,6,0"
                                                                        Visibility="{Binding Passed, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <materialDesign:PackIcon Grid.Column="0" 
                                                                        Kind="CloseCircle"
                                                                        Foreground="{DynamicResource Win11ErrorBrush}" 
                                                                        Width="16" Height="16" 
                                                                        Margin="0,2,6,0"
                                                                        Visibility="{Binding Passed, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                <StackPanel Grid.Column="1">
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding ConditionType}" FontWeight="SemiBold" FontSize="11"/>
                                                        <TextBlock Text="{Binding Operator}" Opacity="0.6" FontSize="10" Margin="6,0,0,0"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding DetailMessage}" FontSize="10" Opacity="0.8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer Apply Action Bar & Progress -->
        <Border Grid.Row="4" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status & Progress -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Opacity="0.8" FontWeight="SemiBold"/>
                    <ProgressBar Value="{Binding ExecutionProgress}" 
                                 Maximum="100" 
                                 Height="4" 
                                 Margin="0,4,16,0"
                                 Visibility="{Binding IsExecuting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Apply Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel Batch"
                            Command="{Binding CancelExecutionCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{DynamicResource Win11ErrorBrush}"
                            Height="36" Margin="0,0,8,0"
                            Visibility="{Binding IsExecuting, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Content="{Binding ApplyButtonText}"
                            Command="{Binding ApplyChangesCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="36" Padding="16,0"
                            AutomationProperties.Name="Apply approved changes"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
