<Window x:Class="TidyUp.Views.RuleConflictsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Multi-Rule Conflict &amp; Dependency Analyzer"
        Height="600" Width="850"
        MinHeight="450" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:Card Grid.Row="0" Padding="16" Margin="0,0,0,16" Background="#EDE7F6">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="AlertDecagram" Width="28" Height="28" Foreground="#512DA8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Multi-Rule Interactions &amp; Conflict Analysis" FontSize="18" FontWeight="Bold" Foreground="#311B92" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding SummaryText}" FontSize="13" Foreground="#4527A0" Margin="38,6,0,0"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- Conflict List -->
        <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource MaterialDesignDivider}" CornerRadius="4">
            <ListView ItemsSource="{Binding Conflicts}" SelectedItem="{Binding SelectedConflict}" BorderThickness="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card Margin="4,6" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Type and Severity Header -->
                                <DockPanel Grid.Row="0" LastChildFill="False">
                                    <Border CornerRadius="4" Padding="6,2" Background="#FFEBEE" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding ConflictType}" Foreground="#C62828" FontWeight="Bold" FontSize="11"/>
                                    </Border>
                                    <Border CornerRadius="4" Padding="6,2" Background="#FFF3E0">
                                        <TextBlock Text="{Binding Severity}" Foreground="#E65100" FontWeight="SemiBold" FontSize="11"/>
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding FolderPath}" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- Description -->
                                <TextBlock Grid.Row="1" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,8,0,6" FontSize="13" FontWeight="Medium"/>

                                <!-- Recommendation -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                                    <materialDesign:PackIcon Kind="LightbulbOutline" Width="16" Height="16" Foreground="#F57F17" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" FontSize="12" Foreground="#E65100" FontWeight="Medium"/>
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Actions -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="_Close" Width="100" Click="CloseButton_Click"/>
        </DockPanel>
    </Grid>
</Window>

