<Window x:Class="TidyUp.Views.Dialogs.RuleDiagnosticsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:TidyUp.ViewModels"
        xmlns:diagnostics="clr-namespace:TidyUp.Services.Diagnostics"
        mc:Ignorable="d"
        Title="Rule Condition Inspector &amp; Diagnostics"
        Height="620" Width="820"
        MinHeight="480" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <HierarchicalDataTemplate DataType="{x:Type diagnostics:ConditionEvaluationResult}" ItemsSource="{Binding Children}">
            <Border Margin="0,4,0,4" Padding="10,8" CornerRadius="6" Background="{DynamicResource MaterialDesignToolBarBackground}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Pass/Fail Icon -->
                    <materialDesign:PackIcon Grid.Column="0"
                                            Width="24" Height="24"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="{x:Type materialDesign:PackIcon}">
                                <Setter Property="Kind" Value="CheckCircle"/>
                                <Setter Property="Foreground" Value="#2E7D32"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMatch}" Value="False">
                                        <Setter Property="Kind" Value="CloseCircle"/>
                                        <Setter Property="Foreground" Value="#C62828"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>

                    <!-- Details -->
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ConditionType}" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Text=" - " Opacity="0.5" Margin="4,0"/>
                            <TextBlock Text="{Binding Operator}" FontWeight="SemiBold" Opacity="0.8"/>
                            <TextBlock Text=": " Opacity="0.5"/>
                            <TextBlock Text="{Binding TargetValue}" FontStyle="Italic"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="Actual File Value: " Opacity="0.6" FontSize="11"/>
                            <TextBlock Text="{Binding ActualValue}" FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Explanation}"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMatch}" Value="False">
                                            <Setter Property="Foreground" Value="#C62828"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header Zone -->
            <RowDefinition Height="Auto"/>
            <!-- 1: File & Rule Selector Card -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Condition Evaluation Tree -->
            <RowDefinition Height="*"/>
            <!-- 3: Footer Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0: Header Zone -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="FileSearchOutline" Width="30" Height="30" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="Explainable Rule Decision Inspector" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Diagnose exact condition matches, thresholds, and rejection reasons for any file"
                               FontSize="12" Foreground="White" Opacity="0.9"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:ColorZone>

        <!-- 1: File & Rule Selector Card -->
        <materialDesign:Card Grid.Row="1" Margin="16,12,16,8" Padding="14,10" UniformCornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0: Rule Selection -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                    <TextBlock Text="Target Rule" FontSize="11" Opacity="0.6" Margin="0,0,0,2"/>
                    <ComboBox ItemsSource="{Binding AvailableRules}"
                              SelectedItem="{Binding SelectedRule}"
                              DisplayMemberPath="Name"
                              materialDesign:HintAssist.Hint="Select a rule to test"/>
                </StackPanel>

                <!-- Row 1: File Path Input -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Target File Path" FontSize="11" Opacity="0.6" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding TargetFilePath, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Enter or browse full file path to test"/>
                </StackPanel>

                <!-- Browse & Inspect Buttons -->
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Browse..."
                            Click="BrowseFile_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0" Height="36"/>
                    <Button Content="Inspect File"
                            Command="{Binding InspectFileCommand}"
                            IsEnabled="{Binding CanInspect}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="36"/>
                </StackPanel>

                <!-- Row 2: Status / Match Banner -->
                <materialDesign:Card Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0" Padding="12,8"
                                    UniformCornerRadius="4"
                                    Visibility="{Binding HasDiagnostics, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <materialDesign:Card.Style>
                        <Style TargetType="materialDesign:Card">
                            <Setter Property="Background" Value="#E8F5E9"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMatch}" Value="False">
                                    <Setter Property="Background" Value="#FFEBEE"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:Card.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,8,0">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Kind" Value="CheckCircle"/>
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMatch}" Value="False">
                                            <Setter Property="Kind" Value="AlertCircle"/>
                                            <Setter Property="Foreground" Value="#C62828"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                        <TextBlock Text="{Binding ResultSummary}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMatch}" Value="False">
                                            <Setter Property="Foreground" Value="#C62828"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </materialDesign:Card>

        <!-- 2: Condition Evaluation Tree -->
        <GroupBox Grid.Row="2" Margin="16,4,16,12" Header="Condition Breakdown (Pass/Fail Explanation Tree)"
                  Style="{StaticResource MaterialDesignCardGroupBox}">
            <TreeView ItemsSource="{Binding Diagnostics.Conditions}"
                      BorderThickness="0"
                      Background="Transparent">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="{x:Type TreeViewItem}">
                        <Setter Property="IsExpanded" Value="True"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </GroupBox>

        <!-- 3: Footer Actions -->
        <Border Grid.Row="3" Background="{DynamicResource MaterialDesignToolBarBackground}" Padding="16,10">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right"
                        Content="Close"
                        IsCancel="True"
                        Click="CloseButton_Click"
                        Style="{StaticResource MaterialDesignFlatButton}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
