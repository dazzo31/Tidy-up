<Window x:Class="TidyUp.Views.Dialogs.SafeguardConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Destructive Operation Safeguard"
        Height="550" Width="750"
        MinHeight="450" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FocusManager.FocusedElement="{Binding ElementName=CancelButton}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Warning Header Zone -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Risk Summary Alert Card -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Files At Risk Grid -->
            <RowDefinition Height="*"/>
            <!-- 3: Action Buttons (Cancel focused) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0: Warning Header Zone -->
        <materialDesign:ColorZone Grid.Row="0" Mode="SecondaryDark" Background="#C62828" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="AlertOctagon" Width="32" Height="32" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="Destructive Operation Warning" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Please review the irreversible actions and potential risks below before proceeding"
                               FontSize="12" Foreground="White" Opacity="0.9"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:ColorZone>

        <!-- 1: Risk Summary Alert Card -->
        <materialDesign:Card Grid.Row="1" Margin="16,12,16,8" Padding="14,10" Background="#FFEBEE" UniformCornerRadius="6">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <materialDesign:PackIcon Kind="ShieldAlert" Foreground="#C62828" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Risks Identified in this Batch:" FontWeight="Bold" Foreground="#C62828" FontSize="13"/>
                </StackPanel>
                <TextBlock Text="{Binding RiskSummary}" Foreground="#B71C1C" FontSize="12" TextWrapping="Wrap" Margin="26,0,0,0" LineHeight="18"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- 2: Files At Risk Grid -->
        <GroupBox Grid.Row="2" Margin="16,4,16,12" Header="Files Subject to High-Risk or Irreversible Operations"
                  Style="{StaticResource MaterialDesignCardGroupBox}">
            <DataGrid ItemsSource="{Binding FilesAtRisk}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <!-- Risk Badge -->
                    <DataGridTemplateColumn Header="Risk Type" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding RiskBadgeBackground}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding RiskBadgeText}"
                                               Foreground="{Binding RiskBadgeForeground}"
                                               FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- File Path -->
                    <DataGridTextColumn Header="Source File"
                                        Binding="{Binding FilePath}"
                                        Width="*" MinWidth="220"/>

                    <!-- Proposed Target -->
                    <DataGridTextColumn Header="Target / Result"
                                        Binding="{Binding TargetPath, TargetNullValue='(permanent delete)'}"
                                        Width="*" MinWidth="180"/>

                    <!-- Rule Name -->
                    <DataGridTextColumn Header="Rule"
                                        Binding="{Binding RuleName}"
                                        Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- 3: Action Buttons Bar -->
        <materialDesign:Card Grid.Row="3" Margin="16,0,16,14" Padding="12,8">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Press Esc to cancel safely with no files touched."
                           FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>

                <!-- Confirm Button (Red, explicit confirmation) -->
                <Button DockPanel.Dock="Right"
                        Command="{Binding ConfirmCommand}"
                        Content="I Understand the Risks, Proceed"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#C62828" BorderBrush="#C62828" Foreground="White"
                        IsDefault="False"
                        Height="36" Padding="16,0" Margin="8,0,0,0"/>

                <!-- Cancel Button (Default focus and bound to Esc key) -->
                <Button x:Name="CancelButton"
                        DockPanel.Dock="Right"
                        Command="{Binding CancelCommand}"
                        Content="Cancel (Safe)"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        IsCancel="True"
                        Height="36" Padding="16,0"/>
            </DockPanel>
        </materialDesign:Card>
    </Grid>
</Window>

