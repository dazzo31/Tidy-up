<Window x:Class="TidyUp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Settings" 
        Height="500" Width="600"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Settings" Width="32" Height="32" 
                                        VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="Application Settings" FontSize="24" FontWeight="Bold" 
                          VerticalAlignment="Center"/>
            </StackPanel>
        </materialDesign:ColorZone>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                
                <!-- General Section -->
                <TextBlock Text="General" 
                          FontSize="16" 
                          FontWeight="SemiBold" 
                          Margin="0,0,0,16"/>

                <TextBox materialDesign:HintAssist.Hint="Database Location"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding DatabaseLocation}"
                        IsReadOnly="True"
                        Margin="0,0,0,16"/>

                <ComboBox materialDesign:HintAssist.Hint="Default Conflict Resolution"
                         Style="{StaticResource MaterialDesignOutlinedComboBox}"
                         ItemsSource="{Binding ConflictResolutionOptions}"
                         SelectedItem="{Binding DefaultConflictResolution}"
                         Margin="0,0,0,24"/>

                <!-- Monitoring Section -->
                <TextBlock Text="File Monitoring" 
                          FontSize="16" 
                          FontWeight="SemiBold" 
                          Margin="0,8,0,16"/>

                <CheckBox Content="Automatically start monitoring on application launch"
                         IsChecked="{Binding AutoStartMonitoring}"
                         Style="{StaticResource MaterialDesignCheckBox}"
                         Margin="0,0,0,16"/>

                <TextBlock Text="This feature requires file monitoring to be implemented"
                          Opacity="0.6"
                          FontSize="11"
                          FontStyle="Italic"
                          Margin="24,0,0,16"/>

                <!-- Logs Section -->
                <TextBlock Text="Log Management" 
                          FontSize="16" 
                          FontWeight="SemiBold" 
                          Margin="0,8,0,16"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <TextBlock Text="Automatically delete logs older than"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"/>
                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding LogRetentionDays}"
                            Width="60"
                            Margin="0,0,8,0"/>
                    <TextBlock Text="days"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Notifications Section -->
                <TextBlock Text="Notifications" 
                          FontSize="16" 
                          FontWeight="SemiBold" 
                          Margin="0,8,0,16"/>

                <CheckBox Content="Show notifications when files are processed"
                         IsChecked="{Binding ShowNotifications}"
                         Style="{StaticResource MaterialDesignCheckBox}"
                         Margin="0,0,0,16"/>

                <CheckBox Content="Minimize to system tray"
                         IsChecked="{Binding MinimizeToTray}"
                         Style="{StaticResource MaterialDesignCheckBox}"
                         Margin="0,0,0,16"/>

                <TextBlock Text="⚠️ These features are not yet implemented"
                          Opacity="0.6"
                          FontSize="11"
                          FontStyle="Italic"
                          Margin="24,0,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource MaterialDesignDivider}" 
               BorderThickness="0,1,0,0" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                          Text="{Binding StatusMessage}" 
                          VerticalAlignment="Center"
                          FontSize="12"
                          Opacity="0.7"/>

                <Button Grid.Column="1"
                       Style="{StaticResource MaterialDesignOutlinedButton}"
                       Content="Reset to Defaults"
                       Command="{Binding ResetToDefaultsCommand}"
                       Margin="0,0,8,0"/>

                <Button Grid.Column="2"
                       Style="{StaticResource MaterialDesignOutlinedButton}"
                       Content="Cancel"
                       Click="CancelButton_Click"
                       Margin="0,0,8,0"/>

                <Button Grid.Column="3"
                       Style="{StaticResource MaterialDesignRaisedButton}"
                       Content="Save"
                       Command="{Binding SaveSettingsCommand}"
                       Click="SaveButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
