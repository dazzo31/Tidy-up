<UserControl x:Class="TidyUp.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:TidyUp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <controls:PageHeader Grid.Row="0" Margin="0,0,0,12"
                             Title="Logs"
                             Subtitle="Application and rule-execution events, filterable and exportable."/>

        <!-- Statistics Cards -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,8">
            <materialDesign:Card Margin="0,0,4,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Total" FontSize="12" Opacity="0.7"/>
                    <TextBlock Text="{Binding TotalCount}" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Margin="4,0,4,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Success" FontSize="12" Opacity="0.7"/>
                    <TextBlock Text="{Binding SuccessCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Win11SuccessBrush}"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Margin="4,0,4,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Warnings" FontSize="12" Opacity="0.7"/>
                    <TextBlock Text="{Binding WarningCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Win11WarningBrush}"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Margin="4,0,0,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Errors" FontSize="12" Opacity="0.7"/>
                    <TextBlock Text="{Binding ErrorCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Win11ErrorBrush}"/>
                </StackPanel>
            </materialDesign:Card>
        </UniformGrid>

        <!-- Filters -->
        <materialDesign:Card Grid.Row="2" Margin="0,8,0,8" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Search" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Search logs..."
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0">
                    <TextBlock Text="Status" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AvailableStatuses}"
                              AutomationProperties.Name="Filter by status"
                              SelectedItem="{Binding SelectedStatus}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="8,0">
                    <TextBlock Text="Rule" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AvailableRules}"
                              AutomationProperties.Name="Filter by rule"
                              SelectedItem="{Binding SelectedRule}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="8,0,0,0">
                    <TextBlock Text="Date Range" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding StartDate}" Width="100" Margin="0,0,4,0"
                                    materialDesign:HintAssist.Hint="From" AutomationProperties.Name="From date"/>
                        <TextBlock Text="to" VerticalAlignment="Center" Margin="4,0"/>
                        <DatePicker SelectedDate="{Binding EndDate}" Width="100" Margin="4,0,0,0"
                                    materialDesign:HintAssist.Hint="To" AutomationProperties.Name="To date"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Margin="8,0,0,0">
                    <Button Content="Clear Filters"
                            Command="{Binding ClearFiltersCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Padding="8,4"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- Logs DataGrid -->
        <materialDesign:Card Grid.Row="3" Margin="0,8">
            <DataGrid ItemsSource="{Binding Logs}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Margin="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="140"/>
                    <DataGridTextColumn Header="Rule" Binding="{Binding RuleName}" Width="150"/>
                    <DataGridTextColumn Header="File Path" Binding="{Binding FilePath}" Width="250"/>
                    <DataGridTextColumn Header="Action" Binding="{Binding ActionPerformed}" Width="120"/>
                    <DataGridTemplateColumn Header="Status" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="6,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Win11SuccessBackgroundBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                                    <Setter Property="Background" Value="{DynamicResource Win11ErrorBackgroundBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                    <Setter Property="Background" Value="{DynamicResource Win11WarningBackgroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Win11SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                                        <Setter Property="Foreground" Value="{DynamicResource Win11ErrorBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                        <Setter Property="Foreground" Value="{DynamicResource Win11WarningBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Error Message" Binding="{Binding ErrorMessage}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>

        <!-- Action Buttons -->
        <materialDesign:Card Grid.Row="4" Margin="0,8,0,0" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding LoadLogsCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Refresh"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportToCsvCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Export" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Export CSV"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding DeleteOldLogsCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteClock" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Delete Old"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ClearAllLogsCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteSweep" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Clear All"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
