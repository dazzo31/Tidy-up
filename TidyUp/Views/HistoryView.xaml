<UserControl x:Class="TidyUp.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:TidyUp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header & Filter Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Pagination Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 2: History List Area -->
            <RowDefinition Height="*"/>
            <!-- 3: Status & Export Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0: Header & Filter Controls -->
        <materialDesign:Card Grid.Row="0" Margin="16,12,16,6" Padding="14,10">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <materialDesign:PackIcon Kind="History" Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="Operation History &amp; Rollback Journal" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Durable SQLite journal with expandable audit details and one-click conflict-safe rollback"
                                       FontSize="11" Opacity="0.75"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{Binding LoadPageCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="32" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Filters WrapPanel -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search Input -->
                    <TextBox Width="180" Margin="0,0,12,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Search paths/rules..."
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             VerticalAlignment="Center"/>

                    <!-- Date Range -->
                    <DatePicker Width="115" Margin="0,0,6,0"
                                SelectedDate="{Binding StartDate}"
                                materialDesign:HintAssist.Hint="From Date"
                                VerticalAlignment="Center"/>
                    <DatePicker Width="115" Margin="0,0,12,0"
                                SelectedDate="{Binding EndDate}"
                                materialDesign:HintAssist.Hint="To Date"
                                VerticalAlignment="Center"/>

                    <!-- Rule Filter -->
                    <ComboBox Width="140" Margin="0,0,12,0"
                              ItemsSource="{Binding RuleFilterOptions}"
                              SelectedItem="{Binding SelectedRuleFilter}"
                              materialDesign:HintAssist.Hint="Rule"
                              VerticalAlignment="Center"/>

                    <!-- Action Type Filter -->
                    <ComboBox Width="130" Margin="0,0,12,0"
                              ItemsSource="{Binding ActionTypeFilterOptions}"
                              SelectedItem="{Binding SelectedActionTypeFilter}"
                              materialDesign:HintAssist.Hint="Action Type"
                              VerticalAlignment="Center"/>

                    <!-- Status Filter -->
                    <ComboBox Width="120" Margin="0,0,12,0"
                              ItemsSource="{Binding StatusFilterOptions}"
                              SelectedItem="{Binding SelectedStatusFilter}"
                              materialDesign:HintAssist.Hint="Status"
                              VerticalAlignment="Center"/>

                    <!-- Filter Apply / Clear -->
                    <Button Content="Filter"
                            Command="{Binding LoadPageCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="28" Padding="12,0" Margin="0,0,6,0"/>

                    <Button Content="Clear"
                            Command="{Binding ClearFiltersCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="28" Padding="10,0"/>
                </WrapPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- 1: Pagination Toolbar -->
        <materialDesign:Card Grid.Row="1" Margin="16,4,16,6" Padding="12,6">
            <DockPanel LastChildFill="False">
                <!-- Page size picker -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Records per page:" VerticalAlignment="Center" FontSize="11" Opacity="0.7" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding PageSizeOptions}"
                              SelectedItem="{Binding PageSize}"
                              Width="60" Height="26" VerticalAlignment="Center" FontSize="11"/>
                </StackPanel>

                <!-- Page navigation controls -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding FirstPageCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Width="30" Height="28" Padding="0" ToolTip="First Page">
                        <materialDesign:PackIcon Kind="PageFirst" Width="18" Height="18"/>
                    </Button>

                    <Button Command="{Binding PreviousPageCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Width="30" Height="28" Padding="0" ToolTip="Previous Page">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18"/>
                    </Button>

                    <TextBlock Text="{Binding PageSummary}"
                               VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Margin="10,0"/>

                    <Button Command="{Binding NextPageCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Width="30" Height="28" Padding="0" ToolTip="Next Page">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18"/>
                    </Button>

                    <Button Command="{Binding LastPageCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Width="30" Height="28" Padding="0" ToolTip="Last Page">
                        <materialDesign:PackIcon Kind="PageLast" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </materialDesign:Card>

        <!-- 2: Main History List -->
        <materialDesign:Card Grid.Row="2" Margin="16,4,16,6" Padding="0">
            <Grid>
                <!-- Loading Overlay -->
                <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Top"
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Empty State -->
                <controls:EmptyStateControl
                    IconKind="History"
                    Title="No History Records Found"
                    Description="No operations match your search and filter criteria. Executed file operations will appear in this durable journal."
                    Visibility="{Binding HistoryEntries.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Zero}"
                    Margin="32"/>

                <!-- Virtualized Items List for fast rendering -->
                <ListView ItemsSource="{Binding HistoryEntries}"
                          SelectedItem="{Binding SelectedEntry}"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          BorderThickness="0"
                          Padding="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <controls:HistoryRowControl/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
        </materialDesign:Card>

        <!-- 3: Bottom Status & Export Bar -->
        <materialDesign:Card Grid.Row="3" Margin="16,4,16,12" Padding="12,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="InformationOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.7"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Click="ExportCsv_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="30" Padding="12,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDelimited" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Export CSV" VerticalAlignment="Center" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <Button Click="ExportJson_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="30" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CodeJson" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Export JSON" VerticalAlignment="Center" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>

