<Window x:Class="TidyUp.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Action Log Viewer" 
        Height="600" Width="1200"
        MinHeight="500" MinWidth="800"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="LogRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Success">
                    <Setter Property="Background" Value="#E8F5E9"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Error">
                    <Setter Property="Background" Value="#FFEBEE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter Property="Background" Value="#FFF3E0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                    <Setter Property="Background" Value="#EEEEEE"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <materialDesign:PackIcon Kind="History" Width="32" Height="32" 
                                            VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Action Log" FontSize="24" FontWeight="Bold" 
                              VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignToolButton}"
                            ToolTip="Export to CSV"
                            Click="ExportButton_Click"
                            Margin="4">
                        <materialDesign:PackIcon Kind="Export" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignToolButton}"
                            ToolTip="Refresh"
                            Command="{Binding LoadLogsCommand}"
                            Margin="4">
                        <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignToolButton}"
                            ToolTip="Delete Old Logs"
                            Click="DeleteOldLogsButton_Click"
                            Margin="4">
                        <materialDesign:PackIcon Kind="DeleteSweep" Width="24" Height="24"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>

        <!-- Filter Panel -->
        <materialDesign:Card Grid.Row="1" Margin="8,8,8,4" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search Box -->
                <TextBox Grid.Column="0" Grid.Row="0"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Search (file path, action, error)..."
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,8,8">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding LoadLogsCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Status Filter -->
                <ComboBox Grid.Column="1" Grid.Row="0"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Status"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding FilterStatus}"
                          Margin="0,0,8,8"/>

                <!-- Rule Name Filter -->
                <TextBox Grid.Column="2" Grid.Row="0"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Rule Name"
                         Text="{Binding FilterRuleName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,8,8"/>

                <!-- Date From -->
                <DatePicker Grid.Column="0" Grid.Row="1"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            materialDesign:HintAssist.Hint="From Date"
                            SelectedDate="{Binding FilterStartDate}"
                            Margin="0,0,8,0"/>

                <!-- Date To -->
                <DatePicker Grid.Column="1" Grid.Row="1"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            materialDesign:HintAssist.Hint="To Date"
                            SelectedDate="{Binding FilterEndDate}"
                            Margin="0,0,8,0"/>

                <!-- Buttons -->
                <Button Grid.Column="3" Grid.Row="0" Grid.RowSpan="2"
                        Content="Apply Filters"
                        Command="{Binding LoadLogsCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"/>

                <Button Grid.Column="4" Grid.Row="0" Grid.RowSpan="2"
                        Content="Clear"
                        Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        VerticalAlignment="Center"/>
            </Grid>
        </materialDesign:Card>

        <!-- Log Data Grid -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Logs}"
                  SelectedItem="{Binding SelectedLog}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  RowStyle="{StaticResource LogRowStyle}"
                  Margin="8,4,8,4"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Timestamp" 
                                    Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                    Width="150"/>
                <DataGridTextColumn Header="Rule" 
                                    Binding="{Binding RuleName}"
                                    Width="150"/>
                <DataGridTextColumn Header="File Path" 
                                    Binding="{Binding FilePath}"
                                    Width="250"/>
                <DataGridTextColumn Header="Action" 
                                    Binding="{Binding ActionPerformed}"
                                    Width="120"/>
                <DataGridTextColumn Header="Result Path" 
                                    Binding="{Binding ResultPath}"
                                    Width="250"/>
                <DataGridTextColumn Header="Status" 
                                    Binding="{Binding Status}"
                                    Width="80"/>
                <DataGridTextColumn Header="Error" 
                                    Binding="{Binding ErrorMessage}"
                                    Width="*"
                                    MinWidth="200"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Details Panel (when row selected) -->
        <materialDesign:Card Grid.Row="3" Margin="8,4,8,4" Padding="16">
            <materialDesign:Card.Style>
                <Style TargetType="materialDesign:Card">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedLog, Converter={x:Null}}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedLog, Converter={x:Null}}" Value="{x:Static Visibility.Visible}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </materialDesign:Card.Style>

            <StackPanel DataContext="{Binding SelectedLog}">
                <TextBlock Text="Log Details" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Rule ID:" FontWeight="SemiBold" Margin="0,4,8,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RuleId}" Margin="0,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="File Path:" FontWeight="SemiBold" Margin="0,4,8,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FilePath}" TextWrapping="Wrap" Margin="0,4"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Result Path:" FontWeight="SemiBold" Margin="0,4,8,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ResultPath}" TextWrapping="Wrap" Margin="0,4"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Error:" FontWeight="SemiBold" Margin="0,4,8,4"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ErrorMessage}" 
                              TextWrapping="Wrap" Margin="0,4" Foreground="Red"/>
                </Grid>
            </StackPanel>
        </materialDesign:Card>

        <!-- Status Bar -->
        <materialDesign:ColorZone Grid.Row="4" Mode="PrimaryLight" Padding="8">
            <DockPanel>
                <materialDesign:PackIcon DockPanel.Dock="Left" 
                                        Kind="Information" 
                                        Width="16" Height="16"
                                        VerticalAlignment="Center" 
                                        Margin="0,0,8,0"/>
                <TextBlock Text="{Binding StatusMessage}" 
                          VerticalAlignment="Center" 
                          FontSize="12"/>
                
                <ProgressBar DockPanel.Dock="Right"
                            Width="100"
                            IsIndeterminate="True"
                            Margin="8,0,0,0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource MaterialDesignLinearProgressBar}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </DockPanel>
        </materialDesign:ColorZone>
    </Grid>
</Window>
