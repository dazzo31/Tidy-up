<UserControl x:Class="TidyUp.Views.FoldersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:styles="clr-namespace:TidyUp.Styles"
             xmlns:controls="clr-namespace:TidyUp.Controls"
             xmlns:viewmodels="clr-namespace:TidyUp.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:FoldersViewModel}"
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header and Summary Cards -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Monitored Folders Hub" 
                           Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                           FontWeight="Bold"/>
                <TextBlock Text="Centralized directory monitoring, permission auditing, and real-time watcher status."
                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                           Opacity="0.7" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Stats Bar -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <materialDesign:Card Margin="0,0,8,0" Padding="12,6" UniformCornerRadius="6">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderMultiple" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.7"/>
                        <StackPanel>
                            <TextBlock Text="{Binding TotalFoldersCount}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="Total Folders" FontSize="10" Opacity="0.6"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Margin="0,0,8,0" Padding="12,6" UniformCornerRadius="6">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckCircleOutline" Foreground="{DynamicResource Win11SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding AccessibleCount}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="Accessible" FontSize="10" Opacity="0.6"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="12,6" UniformCornerRadius="6">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="DarkOrange" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding InaccessibleCount}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="Attention Needed" FontSize="10" Opacity="0.6"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </Grid>

        <!-- Quick Add Directory Panel -->
        <materialDesign:Card Grid.Row="1" Margin="0,0,0,16" Padding="14" UniformCornerRadius="8">
            <StackPanel>
                <TextBlock Text="Add Monitored Directory" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding NewFolderPathInput, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Folder path (e.g. C:\Users\User\Downloads)"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,8,0"
                             AutomationProperties.Name="Folder path input"/>

                    <Button Grid.Column="1"
                            Command="{Binding BrowseFolderCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0"
                            ToolTip="Browse for directory">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpen" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Browse..." VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <CheckBox Grid.Column="2"
                              Content="Subfolders"
                              IsChecked="{Binding NewFolderIncludeSubfolders}"
                              Style="{StaticResource MaterialDesignCheckBox}"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              ToolTip="Include all child subfolders"/>

                    <TextBox Grid.Column="3"
                             Text="{Binding NewFolderExclusionsInput, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Exclusions (e.g. node_modules, .git)"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,8,0"
                             AutomationProperties.Name="Exclusion patterns input"/>

                    <Button Grid.Column="4"
                            Command="{Binding AddMonitoredFolderCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Add Folder" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </materialDesign:Card>

        <!-- Filter & Search Toolbar -->
        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right"
                    Command="{Binding LoadFoldersCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Height="32" Padding="10,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Filter by path, rule name, or access status..."
                     materialDesign:TextFieldAssist.HasClearButton="True"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Height="32"
                     Margin="0,0,12,0"
                     AutomationProperties.Name="Filter folders"/>
        </DockPanel>

        <!-- Monitored Folders Data Table -->
        <materialDesign:Card Grid.Row="3" UniformCornerRadius="8">
            <Grid>
                <!-- Empty State -->
                <controls:EmptyStateControl
                    IconKind="FolderPlus"
                    Title="No Monitored Folders Found"
                    Description="No directories are currently monitored by any rules. Use the input above to add a folder."
                    Visibility="{Binding FilteredFolders.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Zero}"
                    Margin="0,40"/>

                <!-- Folders List -->
                <DataGrid ItemsSource="{Binding FilteredFolders}"
                          SelectedItem="{Binding SelectedFolder}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single"
                          Visibility="{Binding FilteredFolders.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <!-- Status Badge -->
                        <DataGridTemplateColumn Header="Status" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border styles:ThemeBrush.Background="{Binding StatusBadgeFill}"
                                            CornerRadius="4"
                                            Padding="8,3"
                                            HorizontalAlignment="Left"
                                            Margin="4">
                                        <TextBlock Text="{Binding StatusBadgeText}"
                                                   Foreground="{DynamicResource Win11OnSolidBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Path -->
                        <DataGridTemplateColumn Header="Folder Path" Width="*" MinWidth="250">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="4">
                                        <TextBlock Text="{Binding Path}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding PermissionStatus}" FontSize="11" Opacity="0.7"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                    Visibility="{Binding IsTransientLocation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    ToolTip="Windows and cleanup tools routinely delete files from the Temp folder, so a rule watching it can lose its source folder.">
                                            <materialDesign:PackIcon Kind="AlertOutline" Width="12" Height="12" VerticalAlignment="Center"
                                                                     Foreground="{DynamicResource Win11WarningBrush}"/>
                                            <TextBlock Text="Temporary folder" FontSize="11" Margin="4,0,0,0"
                                                       Foreground="{DynamicResource Win11WarningBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Scope (Recursive / Top Level) -->
                        <DataGridTextColumn Header="Scope" Binding="{Binding RecursiveDisplay}" Width="100"/>

                        <!-- Exclusion Patterns -->
                        <DataGridTextColumn Header="Exclusions" Binding="{Binding ExclusionPatternsText}" Width="160"/>

                        <!-- Linked Rules -->
                        <DataGridTemplateColumn Header="Linked Rules" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="4">
                                        <TextBlock Text="{Binding LinkedRulesCount, StringFormat='{}{0} Linked Rules'}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding LinkedRulesSummary}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions Column -->
                        <DataGridTemplateColumn Header="Actions" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- Scan Now -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.ScanFolderNowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Scan folder for active files"
                                                Width="28" Height="28">
                                            <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16"/>
                                        </Button>

                                        <!-- Open in Explorer -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Open directory in Windows Explorer"
                                                Width="28" Height="28">
                                            <materialDesign:PackIcon Kind="FolderOpen" Width="16" Height="16"/>
                                        </Button>

                                        <!-- Pause / Resume -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.TogglePauseWatcherCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Toggle active watcher"
                                                Width="28" Height="28">
                                            <materialDesign:PackIcon Kind="PauseCircleOutline" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>

        <!-- Status Message Footer -->
        <TextBlock Grid.Row="4" 
                   Text="{Binding StatusMessage}" 
                   FontSize="12" 
                   Opacity="0.7" 
                   Margin="4,8,0,0"/>
    </Grid>
</UserControl>

