<UserControl x:Class="TidyUp.Views.RuleEditor.Stages.Stage4ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:TidyUp.ViewModels.RuleEditor"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:RuleWizardViewModel}"
             d:DesignHeight="600" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Instructions -->
            <Border Grid.Row="0" Margin="0,0,0,16" Padding="12" CornerRadius="6" Background="{DynamicResource MaterialDesignToolBarBackground}">
                <StackPanel>
                    <TextBlock Text="Step 4: Review, Validate Safety &amp; Dry Run"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Review rule configuration, check for self-triggering directory loops, and optionally execute a non-destructive dry-run simulation."
                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Opacity="0.7"/>
                </StackPanel>
            </Border>

            <!-- Rule Configuration Summary Card -->
            <materialDesign:Card Grid.Row="1" Margin="0,0,0,16" Padding="16" UniformCornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding RuleName}"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding RuleDescription}"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   Opacity="0.7" Margin="0,2,0,8"
                                   Visibility="{Binding RuleDescription, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- Plain-Language Natural Language Summary -->
                    <Border Margin="0,4,0,12" Padding="12" CornerRadius="6" Background="{DynamicResource PrimaryHueLightBrush}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <materialDesign:PackIcon Kind="TextRecognition" Foreground="{DynamicResource PrimaryHueDarkBrush}" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Plain-Language Summary:" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryHueDarkBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding RuleNaturalLanguageSummary}"
                                       FontSize="13" FontStyle="Italic" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                    </Border>

                    <!-- Folders & Actions Quick Summary -->
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,8,0" Padding="10" CornerRadius="6" Background="{DynamicResource MaterialDesignToolBarBackground}">
                            <StackPanel>
                                <TextBlock Text="Monitored Folders" FontWeight="SemiBold" FontSize="12" Opacity="0.8"/>
                                <ItemsControl ItemsSource="{Binding MonitoredFolders}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Path, StringFormat='• {0}'}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Margin="8,0,0,0" Padding="10" CornerRadius="6" Background="{DynamicResource MaterialDesignToolBarBackground}">
                            <StackPanel>
                                <TextBlock Text="Configured Actions" FontWeight="SemiBold" FontSize="12" Opacity="0.8"/>
                                <ItemsControl ItemsSource="{Binding ActionEditor.Actions}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Type, StringFormat='• {0}'}" FontSize="12"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Default Disabled Notice -->
                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="8,6" CornerRadius="4" Background="#FFF8E1">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="InformationOutline" Foreground="#F57F17" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Safety Notice: This rule will be created in Disabled state by default to prevent premature execution."
                                       FontSize="11" Foreground="#F57F17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </materialDesign:Card>

            <!-- Safety & Loop Validation Section -->
            <materialDesign:Card Grid.Row="2" Margin="0,0,0,16" Padding="16" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Filesystem Safety &amp; Loop Detection"
                               Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                               FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <!-- Success State -->
                    <Border Padding="12" CornerRadius="6" Background="#E8F5E9"
                            Visibility="{Binding ValidationResult.IsValid, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckCircle" Foreground="#2E7D32" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Safety Validation Passed: No recursive moves, nesting hazards, or cycle loops detected."
                                       Foreground="#2E7D32" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Error State -->
                    <Border Padding="12" CornerRadius="6" Background="#FFEBEE" Margin="0,4,0,0"
                            Visibility="{Binding ValidationResult.IsValid, Converter={StaticResource InverseBooleanConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertCircle" Foreground="#C62828" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Validation Issues Detected:" Foreground="#C62828" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding ValidationResult.Errors}" Margin="30,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ErrorMessage, StringFormat='• {0}'}" Foreground="#C62828" FontSize="12"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </materialDesign:Card>

            <!-- Dry-Run Simulation Card -->
            <materialDesign:Card Grid.Row="3" Margin="0,0,0,16" Padding="16" UniformCornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Read-Only Dry-Run Simulation"
                                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Preview exactly which files will be affected and where they will go without touching the disk."
                                       Style="{StaticResource MaterialDesignCaptionTextBlock}" Opacity="0.6"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Command="{Binding RunDryRunCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                ToolTip="Simulate rule against monitored folders">
                            <StackPanel Orientation="Horizontal">
                                <ProgressBar IsIndeterminate="True" Width="16" Height="16"
                                             Style="{StaticResource MaterialDesignCircularProgressBar}"
                                             Visibility="{Binding IsDryRunning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             Margin="0,0,6,0"/>
                                <materialDesign:PackIcon Kind="TestTube" VerticalAlignment="Center" Margin="0,0,4,0"
                                                         Visibility="{Binding IsDryRunning, Converter={StaticResource InverseBooleanConverter}}"/>
                                <TextBlock Text="Simulate Now" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Dry-Run Results (if available) -->
                    <Border Grid.Row="1" Margin="0,8,0,0" Padding="12" CornerRadius="6"
                            Background="{DynamicResource MaterialDesignToolBarBackground}"
                            Visibility="{Binding ExecutionPlan, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Simulation Results: " FontWeight="Bold"/>
                                <TextBlock Text="{Binding ExecutionPlan.TotalScanned, StringFormat='{}{0} files scanned'}" Margin="0,0,8,0"/>
                                <TextBlock Text=" • "/>
                                <TextBlock Text="{Binding ExecutionPlan.TotalMatched, StringFormat='{}{0} files matched'}" FontWeight="SemiBold" Foreground="#1976D2" Margin="0,0,8,0"/>
                                <TextBlock Text=" • "/>
                                <TextBlock Text="{Binding ExecutionPlan.ConflictCount, StringFormat='{}{0} conflicts'}" Foreground="Red"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding ExecutionPlan.PlannedActions}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="11" Margin="0,2,0,2">
                                            <Run Text="[Plan] " FontWeight="Bold" Foreground="#1976D2"/>
                                            <Run Text="{Binding ActionType}"/>
                                            <Run Text=": "/>
                                            <Run Text="{Binding SourcePath}"/>
                                            <Run Text=" ➔ "/>
                                            <Run Text="{Binding TargetPath}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </ScrollViewer>
</UserControl>
