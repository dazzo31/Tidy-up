<UserControl x:Class="TidyUp.Views.RuleEditor.Stages.Stage1FoldersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:TidyUp.Controls"
             xmlns:viewmodels="clr-namespace:TidyUp.ViewModels.RuleEditor"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:RuleWizardViewModel}"
             d:DesignHeight="550" d:DesignWidth="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Step Instructions -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="12" CornerRadius="6" Background="{DynamicResource MaterialDesignToolBarBackground}">
            <StackPanel>
                <TextBlock Text="Step 1: Configure Rule Name &amp; Monitored Folders"
                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Specify a clear rule name and select the directory or directories that TidyUp will monitor for new or modified files."
                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                           Opacity="0.7"/>
            </StackPanel>
        </Border>

        <!-- Rule Name & Description -->
        <materialDesign:Card Grid.Row="1" Margin="0,0,0,16" Padding="16" UniformCornerRadius="8">
            <StackPanel>
                <TextBox Text="{Binding RuleName, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Rule Name (e.g., Clean Downloads, Organize Receipts) *"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,12"
                         AutomationProperties.Name="Rule Name"/>

                <TextBox Text="{Binding RuleDescription, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Rule Description (Optional)"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         AcceptsReturn="True"
                         MaxHeight="60"
                         AutomationProperties.Name="Rule Description"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- Add Folder Input -->
        <materialDesign:Card Grid.Row="2" Margin="0,0,0,16" Padding="16" UniformCornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding NewFolderPathInput, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Enter or browse for folder path to monitor..."
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,8,0"
                         AutomationProperties.Name="Folder path input"/>

                <Button Grid.Column="1"
                         Command="{Binding BrowseAndAddFolderCommand}"
                         Style="{StaticResource MaterialDesignOutlinedButton}"
                         Margin="0,0,8,0"
                         ToolTip="Browse for directory">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderOpen" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="_Browse..." VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                         Command="{Binding AddFolderCommand}"
                         Style="{StaticResource MaterialDesignRaisedButton}"
                         ToolTip="Add folder to monitored list">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="_Add Folder" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </materialDesign:Card>

        <!-- Monitored Folders List -->
        <materialDesign:Card Grid.Row="3" Padding="16" UniformCornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Monitored Folders List"
                           Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                           FontWeight="SemiBold" Margin="0,0,0,8"/>

                <!-- Empty State for Wizard Folders -->
                <controls:EmptyStateControl Grid.Row="1"
                    IconKind="FolderPlus"
                    Title="No Folders Selected"
                    Description="Add at least one directory to monitor for this rule using the Browse button or path input above."
                    Visibility="{Binding MonitoredFolders.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Zero}"
                    Margin="0,16"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding MonitoredFolders.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding MonitoredFolders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="12" CornerRadius="6"
                                        Background="{DynamicResource MaterialDesignToolBarBackground}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <materialDesign:PackIcon Grid.Column="0" Kind="Folder"
                                                                Width="24" Height="24"
                                                                Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                                VerticalAlignment="Center" Margin="0,0,10,0"/>

                                        <TextBlock Grid.Column="1" Text="{Binding Path}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <CheckBox Grid.Column="2" Content="Recursive (Subfolders)"
                                                  IsChecked="{Binding IncludeSubfolders}"
                                                  VerticalAlignment="Center" Margin="12,0,12,0"/>

                                        <TextBox Grid.Column="3"
                                                 Text="{Binding ExclusionPatternsText, UpdateSourceTrigger=LostFocus}"
                                                 materialDesign:HintAssist.Hint="Exclusions (e.g. *.tmp, .git)"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 VerticalAlignment="Center" Height="36"
                                                 Margin="0,0,8,0"/>

                                        <Button Grid.Column="4"
                                                Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Foreground="Red" ToolTip="Remove Folder">
                                            <materialDesign:PackIcon Kind="TrashCanOutline"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
