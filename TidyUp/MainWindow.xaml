<Window x:Class="TidyUp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TidyUp"
        xmlns:controls="clr-namespace:TidyUp.Controls"
        xmlns:views="clr-namespace:TidyUp.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="TidyUp - File Organization Manager" 
        Height="720" Width="1280"
        MinHeight="600" MinWidth="900"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip">
    
    <!-- Keyboard Shortcuts -->
    <Window.InputBindings>
        <!-- Ctrl+N: New Rule -->
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding CreateNewRuleCommand}"/>
        
        <!-- Ctrl+S: Save Rule -->
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveRuleCommand}"/>
        
        <!-- Delete: Delete Rule -->
        <KeyBinding Key="Delete" Command="{Binding DeleteRuleCommand}"/>
        
        <!-- Space: Toggle Enable/Disable -->
        <KeyBinding Key="Space" Command="{Binding ToggleRuleCommand}"/>
        
        <!-- F5: Refresh Rules -->
        <KeyBinding Key="F5" Command="{Binding LoadRulesCommand}"/>
        
        <!-- Ctrl+T: Test Rule -->
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding TestRuleCommand}"/>
        
        <!-- F1: Help -->
        <KeyBinding Key="F1" Command="{Binding ViewHelpCommand}"/>
    </Window.InputBindings>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="8,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <materialDesign:PackIcon Kind="FolderCog" Width="24" Height="24" 
                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="TidyUp" FontSize="18" FontWeight="Bold" 
                              VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignToolButton}"
                            ToolTip="Minimize"
                            Click="MinimizeButton_Click"
                            Margin="2">
                        <materialDesign:PackIcon Kind="WindowMinimize" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignToolButton}"
                            ToolTip="Maximize/Restore"
                            Click="MaximizeRestoreButton_Click"
                            Margin="2">
                        <materialDesign:PackIcon Kind="WindowMaximize" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignToolButton}"
                            ToolTip="Close"
                            Click="CloseButton_Click"
                            Margin="2">
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                    </Button>
                    <Separator Style="{StaticResource MaterialDesignSeparator}" 
                              Margin="4,0"
                              Width="2"
                              Background="{DynamicResource MaterialDesignDivider}"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignToolButton}"
                            ToolTip="New Rule (Ctrl+N)"
                            Command="{Binding CreateNewRuleCommand}"
                            Margin="2">
                        <materialDesign:PackIcon Kind="Plus" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignToolButton}"
                            ToolTip="Import Rules"
                            Command="{Binding ImportRulesCommand}"
                            Margin="2">
                        <materialDesign:PackIcon Kind="Import" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignToolButton}"
                            ToolTip="Export Selected Rule"
                            Command="{Binding ExportRuleCommand}"
                            Margin="2">
                        <materialDesign:PackIcon Kind="Export" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignToolButton}"
                            ToolTip="Export All Rules"
                            Command="{Binding ExportAllRulesCommand}"
                            Margin="2">
                        <materialDesign:PackIcon Kind="ExportVariant" Width="20" Height="20"/>
                    </Button>
                    <Separator Style="{StaticResource MaterialDesignSeparator}" 
                              Margin="4,0"
                              Width="2"
                              Background="{DynamicResource MaterialDesignDivider}"/>
                    <Button Style="{StaticResource MaterialDesignToolButton}"
                            ToolTip="Test Rule (Ctrl+T)"
                            Command="{Binding TestRuleCommand}"
                            Margin="2">
                        <materialDesign:PackIcon Kind="TestTube" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignToolButton}"
                            ToolTip="Refresh Rules (F5)"
                            Command="{Binding LoadRulesCommand}"
                            Margin="2">
                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignToolButton}"
                            ToolTip="View Logs"
                            Command="{Binding ViewLogsCommand}"
                            Margin="2">
                        <materialDesign:PackIcon Kind="History" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignToolButton}"
                            ToolTip="Help (F1)"
                            Command="{Binding ViewHelpCommand}"
                            Margin="2">
                        <materialDesign:PackIcon Kind="HelpCircle" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignToolButton}"
                            ToolTip="Settings"
                            Command="{Binding OpenSettingsCommand}"
                            Margin="2">
                        <materialDesign:PackIcon Kind="Settings" Width="20" Height="20"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Rule List -->
            <materialDesign:Card Grid.Column="0" Margin="4,4,2,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Rule List Header -->
                    <Border Grid.Row="0" Background="{DynamicResource MaterialDesignDivider}" 
                            Padding="12,8">
                        <TextBlock Text="Rules" FontSize="14" FontWeight="SemiBold"/>
                    </Border>
                    
                    <!-- Search Box -->
                    <TextBox Grid.Row="1"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            materialDesign:HintAssist.Hint="Search rules..."
                            materialDesign:TextFieldAssist.HasClearButton="True"
                            Margin="8,8,8,4">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                <Setter Property="materialDesign:HintAssist.Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Rules ListBox -->
                    <ListBox Grid.Row="2" 
                             ItemsSource="{Binding FilteredRules}"
                             SelectedItem="{Binding SelectedRule}"
                             Style="{StaticResource MaterialDesignListBox}"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="RuleListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="RuleListBox_PreviewMouseMove"
                             Drop="RuleListBox_Drop"
                             DragOver="RuleListBox_DragOver"
                             Margin="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Enabled Status Icon -->
                                    <materialDesign:PackIcon Grid.Column="0"
                                                            Width="16" Height="16"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,6,0">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="Check"/>
                                                <Setter Property="Foreground" Value="Green"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Kind" Value="Close"/>
                                                        <Setter Property="Foreground" Value="Red"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>

                                    <!-- Rule Name and Details -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" 
                                                  FontWeight="SemiBold"
                                                  FontSize="13"
                                                  TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Description}" 
                                                  Opacity="0.7"
                                                  FontSize="10"
                                                  TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Rule Order Badge -->
                                    <Border Grid.Column="2"
                                           Background="{DynamicResource PrimaryHueLightBrush}"
                                           CornerRadius="8"
                                           Padding="6,2"
                                           VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ExecutionOrder}" 
                                                  FontSize="10"
                                                  FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </materialDesign:Card>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1" Width="4" 
                         HorizontalAlignment="Stretch" 
                         Background="{DynamicResource MaterialDesignDivider}"/>

            <!-- Right Panel: Rule Details -->
            <materialDesign:Card Grid.Column="2" Margin="2,4,4,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Navigation Header -->
                    <Border Grid.Row="0" Background="{DynamicResource MaterialDesignDivider}" 
                            Padding="12,8">
                        <DockPanel>
                            <!-- Back Button (visible when not in RuleEditor) -->
                            <Button DockPanel.Dock="Left"
                                   ToolTip="Back to Rules"
                                   Command="{Binding NavigateToRuleEditorCommand}"
                                   Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentView}" Value="Settings">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentView}" Value="Logs">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentView}" Value="Help">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18"/>
                            </Button>
                            
                            <!-- Dynamic Title -->
                            <TextBlock DockPanel.Dock="Left" FontSize="14" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Rule Details"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentView}" Value="Settings">
                                                <Setter Property="Text" Value="Settings"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentView}" Value="Logs">
                                                <Setter Property="Text" Value="Logs"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentView}" Value="Help">
                                                <Setter Property="Text" Value="Help"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            
                            <!-- Rule Actions (only visible in RuleEditor view) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentView}" Value="Settings">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentView}" Value="Logs">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentView}" Value="Help">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                       ToolTip="Toggle Enable/Disable (Space)"
                                       Command="{Binding ToggleRuleCommand}"
                                       Margin="2,0">
                                    <materialDesign:PackIcon Kind="Power" Width="18" Height="18"/>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                       ToolTip="Delete Rule (Delete)"
                                       Command="{Binding DeleteRuleCommand}"
                                       Margin="2,0">
                                    <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Content Switcher -->
                    <Grid Grid.Row="1">
                        <!-- Rule Editor View -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentView}" Value="Settings">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentView}" Value="Logs">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentView}" Value="Help">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <Grid Margin="12">
                                <!-- Show message when no rule is selected -->
                                <TextBlock Text="Select a rule from the list to view and edit details."
                                      Opacity="0.6"
                                      FontSize="14"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="0,48,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedRule}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Rule Editor (shown when rule is selected) -->
                            <StackPanel DataContext="{Binding SelectedRule}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBox materialDesign:HintAssist.Hint="Rule Name"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                        FontSize="13"
                                        Margin="0,0,0,8"/>

                                <TextBox materialDesign:HintAssist.Hint="Description (Optional)"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                        FontSize="13"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinLines="1"
                                        MaxLines="2"
                                        Margin="0,0,0,8"/>

                                <CheckBox Content="Enabled"
                                         IsChecked="{Binding IsEnabled}"
                                         Style="{StaticResource MaterialDesignCheckBox}"
                                         Margin="0,0,0,8"/>

                                <CheckBox Content="Stop processing after this rule matches"
                                         IsChecked="{Binding StopProcessingAfterMatch}"
                                         Style="{StaticResource MaterialDesignCheckBox}"
                                         Margin="0,0,0,12"/>

                                <!-- Tabs for Folders, Conditions, Actions -->
                                <TabControl Style="{StaticResource MaterialDesignTabControl}" Margin="0,8,0,0">
                                    <TabItem Header="Folders">
                                        <Grid Margin="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header -->
                                            <TextBlock Grid.Row="0" Text="📁 Monitored Folders"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      Margin="0,0,0,8"/>

                                            <!-- Folder List -->
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding MonitoredFolders}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <materialDesign:Card Margin="0,0,0,6" Padding="8">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>

                                                                    <!-- Path Row -->
                                                                    <Grid Grid.Row="0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <materialDesign:PackIcon Grid.Column="0" 
                                                                                                Kind="Folder" 
                                                                                                Width="16" Height="16"
                                                                                                VerticalAlignment="Center"
                                                                                                Margin="0,0,6,0"/>

                                                                        <TextBox Grid.Column="1"
                                                                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                                                materialDesign:HintAssist.Hint="Folder Path"
                                                                                Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                                                                                Margin="0,0,8,0"/>

                                                                        <Button Grid.Column="2"
                                                                               Style="{StaticResource MaterialDesignIconButton}"
                                                                               ToolTip="Browse"
                                                                               Click="BrowseFolderButton_Click"
                                                                               Tag="{Binding}"
                                                                               Margin="0,0,4,0">
                                                                            <materialDesign:PackIcon Kind="FolderOpen" Width="18" Height="18"/>
                                                                        </Button>

                                                                        <Button Grid.Column="3"
                                                                               Style="{StaticResource MaterialDesignIconButton}"
                                                                               ToolTip="Remove Folder"
                                                                               Click="RemoveFolderButton_Click"
                                                                               Tag="{Binding}"
                                                                               Foreground="Red">
                                                                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                                                                        </Button>
                                                                    </Grid>

                                                                    <!-- Options Row -->
                                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="22,4,0,0">
                                                                        <CheckBox Content="Include Subfolders"
                                                                                 IsChecked="{Binding IncludeSubfolders}"
                                                                                 Style="{StaticResource MaterialDesignCheckBox}"
                                                                                 FontSize="12"
                                                                                 Margin="0,0,16,0"/>
                                                                    </StackPanel>

                                                                    <!-- Exclusion Patterns -->
                                                                    <TextBox Grid.Row="2"
                                                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                                            materialDesign:HintAssist.Hint="Exclusion Patterns (comma-separated, e.g., node_modules, .git)"
                                                                            Text="{Binding ExclusionPatternsText, UpdateSourceTrigger=PropertyChanged}"
                                                                            FontSize="12"
                                                                            Margin="22,4,0,0"/>
                                                                </Grid>
                                                            </materialDesign:Card>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <!-- Add Button -->
                                            <Button Grid.Row="2"
                                                   Style="{StaticResource MaterialDesignOutlinedButton}"
                                                   Click="AddFolderButton_Click"
                                                   Margin="0,8,0,0"
                                                   HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Add Folder" VerticalAlignment="Center" FontSize="12"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Empty State -->
                                            <TextBlock Grid.Row="1"
                                                      Text="No folders added yet. Click 'Add Folder' to start monitoring."
                                                      Opacity="0.6"
                                                      FontStyle="Italic"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MonitoredFolders.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </TabItem>
                                    
                                    <TabItem Header="Conditions">
                                        <controls:ConditionEditorControl DataContext="{Binding DataContext.ConditionEditor, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </TabItem>
                                    
                                    <TabItem Header="Actions">
                                        <controls:ActionEditorControl DataContext="{Binding DataContext.ActionEditor, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                        <!-- Settings View -->
                        <views:SettingsView DataContext="{Binding DataContext.SettingsViewModel, RelativeSource={RelativeSource AncestorType=Window}}">
                            <views:SettingsView.Style>
                                <Style TargetType="views:SettingsView">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}}" Value="Settings">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:SettingsView.Style>
                        </views:SettingsView>

                        <!-- Logs View -->
                        <views:LogsView DataContext="{Binding DataContext.LogsViewModel, RelativeSource={RelativeSource AncestorType=Window}}">
                            <views:LogsView.Style>
                                <Style TargetType="views:LogsView">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}}" Value="Logs">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:LogsView.Style>
                        </views:LogsView>

                        <!-- Help View -->
                        <views:HelpView>
                            <views:HelpView.Style>
                                <Style TargetType="views:HelpView">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}}" Value="Help">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:HelpView.Style>
                        </views:HelpView>
                    </Grid>

                    <!-- Save Button (only for Rule Editor) -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource MaterialDesignDivider}" 
                           BorderThickness="0,1,0,0" Padding="12,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="Settings">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="Logs">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="Help">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                               Content="Save Rule"
                               Command="{Binding SaveRuleCommand}"
                               HorizontalAlignment="Right"/>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- Status Bar -->
        <materialDesign:ColorZone Grid.Row="2" Mode="PrimaryLight" Padding="6,4">
            <DockPanel>
                <materialDesign:PackIcon Kind="Information" 
                                        VerticalAlignment="Center" 
                                        Width="14" Height="14"
                                        Margin="6,0"
                                        DockPanel.Dock="Left"/>
                <TextBlock Text="{Binding StatusMessage}" 
                          VerticalAlignment="Center"
                          FontSize="12"
                          DockPanel.Dock="Left"/>
                <ProgressBar IsIndeterminate="True" 
                            Width="100" 
                            Height="4"
                            HorizontalAlignment="Right">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </DockPanel>
        </materialDesign:ColorZone>
    </Grid>
</Window>
