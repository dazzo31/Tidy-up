<Window x:Class="TidyUp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TidyUp"
        xmlns:controls="clr-namespace:TidyUp.Controls"
        xmlns:views="clr-namespace:TidyUp.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" 
        Height="720" Width="1280"
        MinHeight="600" MinWidth="900"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/Resources/tidyup.ico">
    
    <!-- Keyboard Shortcuts -->
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavigateToDashboardCommand}"/>
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigateToRuleEditorCommand}"/>
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavigateToFoldersCommand}"/>
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding NavigateToPreviewReviewCommand}"/>
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding ViewHistoryCommand}"/>
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding OpenSettingsCommand}"/>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding NavigateToDashboardCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding CreateNewRuleCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveRuleCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteRuleCommand}"/>
        <KeyBinding Key="Space" Command="{Binding ToggleRuleCommand}"/>
        <KeyBinding Key="F5" Command="{Binding LoadRulesCommand}"/>
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding TestRuleCommand}"/>
        <KeyBinding Key="F1" Command="{Binding ViewHelpCommand}"/>
    </Window.InputBindings>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="68" MaxWidth="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Modern Persistent Navigation Rail (Left Sidebar) -->
        <Border Grid.Column="0" 
                Background="{DynamicResource MaterialDesignToolBarBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- App Header -->
                <Border DockPanel.Dock="Top" 
                        Padding="16,14" 
                        BorderBrush="{DynamicResource MaterialDesignDivider}" 
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Resources/tidyup.ico" 
                               Width="24" Height="24" 
                               VerticalAlignment="Center" 
                               Margin="0,0,10,0"/>
                        <TextBlock Text="TidyUp" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Bottom Quick Actions & Guide -->
                <StackPanel DockPanel.Dock="Bottom" Margin="8,8,8,12">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding CreateNewRuleCommand}"
                            ToolTip="Create New Rule (Ctrl+N)"
                            AutomationProperties.Name="Create New Rule"
                            Height="36"
                            Margin="0,0,0,6"
                            HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="New Rule" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding ViewHelpCommand}"
                            ToolTip="Help &amp; Guide (F1)"
                            AutomationProperties.Name="Help and Guide"
                            Height="32"
                            HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="HelpCircleOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Help &amp; Guide" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 6 Core Navigation Destinations -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,10,8,10">
                        <!-- 1. Dashboard -->
                        <Button Command="{Binding NavigateToDashboardCommand}"
                                ToolTip="Operational Dashboard (Ctrl+1, Ctrl+D)"
                                AutomationProperties.Name="Dashboard"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Height="40" Margin="0,2" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboardOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>

                        <!-- 2. Rules -->
                        <Button Command="{Binding NavigateToRuleEditorCommand}"
                                ToolTip="Rule Management (Ctrl+2)"
                                AutomationProperties.Name="Rules"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Height="40" Margin="0,2" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilterList" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Rules" VerticalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>

                        <!-- 3. Folders -->
                        <Button Command="{Binding NavigateToFoldersCommand}"
                                ToolTip="Monitored Folders (Ctrl+3)"
                                AutomationProperties.Name="Monitored Folders"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Height="40" Margin="0,2" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderMultipleOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Folders" VerticalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>

                        <!-- 4. Preview & Review -->
                        <Button Command="{Binding NavigateToPreviewReviewCommand}"
                                ToolTip="Preview &amp; Review (Ctrl+4, Ctrl+T)"
                                AutomationProperties.Name="Preview and Review"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Height="40" Margin="0,2" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="EyeCheckOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Preview &amp; Review" VerticalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>

                        <!-- 5. History -->
                        <Button Command="{Binding ViewHistoryCommand}"
                                ToolTip="Operation History &amp; Journal (Ctrl+5)"
                                AutomationProperties.Name="History and Journal"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Height="40" Margin="0,2" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="History" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="History" VerticalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>

                        <!-- 6. Settings -->
                        <Button Command="{Binding OpenSettingsCommand}"
                                ToolTip="Settings (Ctrl+6)"
                                AutomationProperties.Name="Settings"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Height="40" Margin="0,2" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CogOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>

                        <Separator Margin="0,8" Background="{DynamicResource MaterialDesignDivider}"/>

                        <!-- Auxiliary: Logs -->
                        <Button Command="{Binding ViewLogsCommand}"
                                ToolTip="System Logs"
                                AutomationProperties.Name="System Logs"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Height="36" Margin="0,2" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocumentOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Logs" VerticalAlignment="Center" Opacity="0.85"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Right Side: Content Area (Row 0) and Status Bar (Row 1) -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Main Content Area -->
            <Grid Grid.Row="0">
                <!-- Rule Editor view (full split layout) -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentView}" Value="RuleEditor">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" MinWidth="220"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="400"/>
                    </Grid.ColumnDefinitions>

                <!-- Left Panel: Rule List -->
                <DockPanel Grid.Column="0" Margin="4,4,2,4">
                    <!-- Rule List Header -->
                    <Border DockPanel.Dock="Top" 
                            Background="{DynamicResource MaterialDesignToolBarBackground}" 
                            Padding="12,6,6,6">
                        <DockPanel>
                            <TextBlock Text="Rules" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button ToolTip="Refresh (F5)" Command="{Binding LoadRulesCommand}" Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28">
                                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"/>
                                </Button>
                                <Button ToolTip="Import Rules" Command="{Binding ImportRulesCommand}" Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28">
                                    <materialDesign:PackIcon Kind="Import" Width="16" Height="16"/>
                                </Button>
                                <Button ToolTip="Export All Rules" Command="{Binding ExportAllRulesCommand}" Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28">
                                    <materialDesign:PackIcon Kind="ExportVariant" Width="16" Height="16"/>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    
                    <!-- Search Box -->
                    <TextBox DockPanel.Dock="Top"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            materialDesign:HintAssist.Hint="Search rules..."
                            materialDesign:TextFieldAssist.HasClearButton="True"
                            Margin="8,8,8,4"
                            AutomationProperties.Name="Search rules">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                <Setter Property="materialDesign:HintAssist.Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Rules List Area with Empty State -->
                    <Grid>
                        <!-- Empty State for Rules -->
                        <controls:EmptyStateControl
                            IconKind="FilterOff"
                            Title="No Rules Configured"
                            Description="No organization rules found. Create a rule to automate sorting and organizing files."
                            ActionText="Create Rule (Ctrl+N)"
                            ActionCommand="{Binding CreateNewRuleCommand}"
                            Visibility="{Binding FilteredRules.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Zero}"
                            Margin="12,24,12,12"/>

                        <!-- Rules ListBox -->
                        <ListBox ItemsSource="{Binding FilteredRules}"
                                 SelectedItem="{Binding SelectedRule}"
                                 Style="{StaticResource MaterialDesignListBox}"
                                 AllowDrop="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 PreviewMouseLeftButtonDown="RuleListBox_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="RuleListBox_PreviewMouseMove"
                                 Drop="RuleListBox_Drop"
                                 DragOver="RuleListBox_DragOver"
                                 AutomationProperties.Name="Rule list"
                                 Visibility="{Binding FilteredRules.Count, Converter={StaticResource CountToVisibilityConverter}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <materialDesign:PackIcon Grid.Column="0"
                                                                Width="16" Height="16"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,6,0">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Kind" Value="CheckCircle"/>
                                                    <Setter Property="Foreground" Value="Green"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                            <Setter Property="Kind" Value="CloseCircle"/>
                                                            <Setter Property="Foreground" Value="Gray"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" 
                                                      FontWeight="SemiBold"
                                                      FontSize="13"
                                                      TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" 
                                                      Opacity="0.6"
                                                      FontSize="11"
                                                      TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                               Background="{DynamicResource MaterialDesignToolBarBackground}"
                                               CornerRadius="8"
                                               Padding="6,2"
                                               VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ExecutionOrder}" 
                                                      FontSize="10"
                                                      FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>

                <!-- GridSplitter -->
                <GridSplitter Grid.Column="1" Width="4" 
                             HorizontalAlignment="Stretch" 
                             Background="{DynamicResource MaterialDesignDivider}"/>

                <!-- Right Panel: Rule Details -->
                <DockPanel Grid.Column="2" Margin="2,4,4,4">
                    <!-- Header -->
                    <Border DockPanel.Dock="Top" 
                            Background="{DynamicResource MaterialDesignToolBarBackground}" 
                            Padding="12,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Rule Details" 
                                      FontSize="14" FontWeight="SemiBold"
                                      VerticalAlignment="Center"/>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                       ToolTip="Test Rule Preview (Ctrl+T)"
                                       Command="{Binding TestRuleCommand}"
                                       AutomationProperties.Name="Test rule preview"
                                       Margin="2,0">
                                    <materialDesign:PackIcon Kind="TestTube" Width="18" Height="18"/>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                       ToolTip="Export Selected Rule"
                                       Command="{Binding ExportRuleCommand}"
                                       AutomationProperties.Name="Export selected rule"
                                       Margin="2,0">
                                    <materialDesign:PackIcon Kind="Export" Width="18" Height="18"/>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                       ToolTip="Toggle Enable/Disable (Space)"
                                       Command="{Binding ToggleRuleCommand}"
                                       AutomationProperties.Name="Toggle rule"
                                       Margin="2,0">
                                    <materialDesign:PackIcon Kind="Power" Width="18" Height="18"/>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                       ToolTip="Delete Rule (Delete)"
                                       Command="{Binding DeleteRuleCommand}"
                                       AutomationProperties.Name="Delete rule"
                                       Margin="2,0">
                                    <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Save Button -->
                    <Border DockPanel.Dock="Bottom" 
                           BorderBrush="{DynamicResource MaterialDesignDivider}" 
                           BorderThickness="0,1,0,0" Padding="12,8">
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                               Content="_Save Rule"
                               Command="{Binding SaveRuleCommand}"
                               AutomationProperties.Name="Save rule"
                               HorizontalAlignment="Right"/>
                    </Border>

                    <!-- Rule Editor Content -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="12">
                            <!-- No rule selected message -->
                            <TextBlock Text="Select a rule from the list, or press Ctrl+N to create a new one."
                                      Opacity="0.6"
                                      FontSize="14"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="0,48,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedRule}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Rule Editor -->
                            <StackPanel DataContext="{Binding SelectedRule}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBox materialDesign:HintAssist.Hint="Rule Name"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                        FontSize="13"
                                        AutomationProperties.Name="Rule name"
                                        Margin="0,0,0,8"/>

                                <TextBox materialDesign:HintAssist.Hint="Description (Optional)"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                        FontSize="13"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinLines="1"
                                        MaxLines="2"
                                        AutomationProperties.Name="Rule description"
                                        Margin="0,0,0,8"/>

                                <CheckBox Content="_Enabled"
                                         IsChecked="{Binding IsEnabled}"
                                         Style="{StaticResource MaterialDesignCheckBox}"
                                         Margin="0,0,0,8"/>

                                <CheckBox Content="Stop processing after this rule matches"
                                         IsChecked="{Binding StopProcessingAfterMatch}"
                                         Style="{StaticResource MaterialDesignCheckBox}"
                                         Margin="0,0,0,12"/>

                                <!-- Tabs -->
                                <TabControl Style="{StaticResource MaterialDesignTabControl}" Margin="0,8,0,0">
                                    <TabItem Header="Folders">
                                        <Grid Margin="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="Monitored Folders"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      Margin="0,0,0,8"/>

                                            <Grid Grid.Row="1">
                                                <controls:EmptyStateControl
                                                    IconKind="FolderPlus"
                                                    Title="No Monitored Folders"
                                                    Description="This rule doesn't monitor any folders yet. Click Add Folder below to start watching directories."
                                                    Visibility="{Binding MonitoredFolders.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Zero}"
                                                    Margin="0,16"/>

                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                              Visibility="{Binding MonitoredFolders.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                                <ItemsControl ItemsSource="{Binding MonitoredFolders}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <materialDesign:Card Margin="0,0,0,6" Padding="8">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>

                                                                    <Grid Grid.Row="0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <materialDesign:PackIcon Grid.Column="0" 
                                                                                                Kind="Folder" 
                                                                                                Width="16" Height="16"
                                                                                                VerticalAlignment="Center"
                                                                                                Margin="0,0,6,0"/>

                                                                        <TextBox Grid.Column="1"
                                                                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                                                materialDesign:HintAssist.Hint="Folder Path"
                                                                                Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                                                                                AutomationProperties.Name="Folder path"
                                                                                Margin="0,0,8,0"/>

                                                                        <Button Grid.Column="2"
                                                                               Style="{StaticResource MaterialDesignIconButton}"
                                                                               ToolTip="Browse"
                                                                               Click="BrowseFolderButton_Click"
                                                                               Tag="{Binding}"
                                                                               AutomationProperties.Name="Browse for folder"
                                                                               Margin="0,0,4,0">
                                                                            <materialDesign:PackIcon Kind="FolderOpen" Width="18" Height="18"/>
                                                                        </Button>

                                                                        <Button Grid.Column="3"
                                                                               Style="{StaticResource MaterialDesignIconButton}"
                                                                               ToolTip="Remove Folder"
                                                                               Click="RemoveFolderButton_Click"
                                                                               Tag="{Binding}"
                                                                               AutomationProperties.Name="Remove folder"
                                                                               Foreground="Red">
                                                                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                                                                        </Button>
                                                                    </Grid>

                                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="22,4,0,0">
                                                                        <CheckBox Content="Include Subfolders"
                                                                                 IsChecked="{Binding IncludeSubfolders}"
                                                                                 Style="{StaticResource MaterialDesignCheckBox}"
                                                                                 FontSize="12"
                                                                                 Margin="0,0,16,0"/>
                                                                    </StackPanel>

                                                                    <TextBox Grid.Row="2"
                                                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                                            materialDesign:HintAssist.Hint="Exclusion Patterns (comma-separated, e.g., node_modules, .git)"
                                                                            Text="{Binding ExclusionPatternsText, UpdateSourceTrigger=PropertyChanged}"
                                                                            FontSize="12"
                                                                            AutomationProperties.Name="Exclusion patterns"
                                                                            Margin="22,4,0,0"/>
                                                                </Grid>
                                                            </materialDesign:Card>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            </Grid>

                                            <Button Grid.Row="2"
                                                   Style="{StaticResource MaterialDesignOutlinedButton}"
                                                   Click="AddFolderButton_Click"
                                                   AutomationProperties.Name="Add folder"
                                                   Margin="0,8,0,0"
                                                   HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="_Add Folder" VerticalAlignment="Center" FontSize="12"/>
                                                </StackPanel>
                                            </Button>

                                            <TextBlock Grid.Row="1"
                                                      Text="No folders added yet. Click 'Add Folder' to start monitoring."
                                                      Opacity="0.6"
                                                      FontStyle="Italic"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MonitoredFolders.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </TabItem>
                                    
                                    <TabItem Header="Conditions">
                                        <controls:ConditionEditorControl DataContext="{Binding DataContext.ConditionEditor, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </TabItem>
                                    
                                    <TabItem Header="Actions">
                                        <controls:ActionEditorControl DataContext="{Binding DataContext.ActionEditor, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <!-- Dashboard View (Operational Overview) -->
            <views:DashboardView DataContext="{Binding DashboardViewModel}">
                <views:DashboardView.Style>
                    <Style TargetType="views:DashboardView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="Dashboard">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:DashboardView.Style>
            </views:DashboardView>

            <!-- Settings View (replaces entire content area) -->
            <views:SettingsView DataContext="{Binding SettingsViewModel}">
                <views:SettingsView.Style>
                    <Style TargetType="views:SettingsView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="Settings">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:SettingsView.Style>
            </views:SettingsView>

            <!-- Logs View -->
            <views:LogsView DataContext="{Binding LogsViewModel}">
                <views:LogsView.Style>
                    <Style TargetType="views:LogsView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="Logs">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:LogsView.Style>
            </views:LogsView>

            <!-- History View -->
            <views:HistoryView DataContext="{Binding HistoryViewModel}">
                <views:HistoryView.Style>
                    <Style TargetType="views:HistoryView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="History">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:HistoryView.Style>
            </views:HistoryView>

            <!-- Folders Hub (Dedicated Workspace) -->
            <Border Background="{DynamicResource MaterialDesignPaper}" Padding="32">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="Folders">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <controls:EmptyStateControl
                    IconKind="FolderMultiple"
                    Title="Monitored Folders Hub"
                    Description="Centralized directory monitoring hub and health status overview."
                    ActionText="View Rules"
                    ActionCommand="{Binding NavigateToRuleEditorCommand}"/>
            </Border>

            <!-- Preview & Review Workspace -->
            <Border Background="{DynamicResource MaterialDesignPaper}" Padding="32">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="PreviewReview">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <controls:EmptyStateControl
                    IconKind="EyeCheckOutline"
                    Title="Preview &amp; Review Workspace"
                    Description="Simulate and verify rule operations safely before applying changes to disk."
                    ActionText="Run Rule Preview (Ctrl+T)"
                    ActionCommand="{Binding TestRuleCommand}"/>
            </Border>

            <!-- Help View -->
            <views:HelpView>
                <views:HelpView.Style>
                    <Style TargetType="views:HelpView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="Help">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:HelpView.Style>
            </views:HelpView>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="1">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Information" 
                                            VerticalAlignment="Center" 
                                            Width="14" Height="14"
                                            Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right" Margin="0,0,12,0">
                <Border Background="{Binding StateBadgeBackground}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="{Binding StateBadgeIcon}" Width="14" Height="14"
                                                 Foreground="{Binding StateBadgeForeground}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding StateBadgeText}" FontSize="10" FontWeight="Bold"
                                   Foreground="{Binding StateBadgeForeground}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar IsIndeterminate="True" 
                            Width="100" 
                            Height="4">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </StatusBarItem>
        </StatusBar>
        </Grid>
    </Grid>
</Window>
