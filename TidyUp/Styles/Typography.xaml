<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Font Family Declarations -->
    <FontFamily x:Key="Win11StandardFontFamily">Segoe UI, Segoe UI Variable, Arial, sans-serif</FontFamily>
    <FontFamily x:Key="Win11MonospaceFontFamily">Consolas, Cascadia Code, Courier New, monospace</FontFamily>

    <!-- Typography TextBlock Styles -->
    <Style x:Key="Win11DisplayTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Win11StandardFontFamily}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="Win11TitleTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Win11StandardFontFamily}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="Win11SubtitleTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Win11StandardFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="Win11BodyTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Win11StandardFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="Win11CaptionTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Win11StandardFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Opacity" Value="0.75"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- Page header (PageHeader control): one H1 size for every destination. -->
    <Style x:Key="Win11PageTitleTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Win11StandardFontFamily}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="36"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="Win11PageSubtitleTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Win11StandardFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource Win11TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="Win11CodeTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Win11MonospaceFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

</ResourceDictionary>

