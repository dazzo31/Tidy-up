<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows 11 Fluent Surface & Border Tokens -->
    <Color x:Key="Win11SubtleBorderColor">#E0E0E0</Color>
    <SolidColorBrush x:Key="Win11SubtleBorderBrush" Color="{StaticResource Win11SubtleBorderColor}"/>

    <Color x:Key="Win11SurfaceColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="Win11SurfaceBrush" Color="{StaticResource Win11SurfaceColor}"/>

    <Color x:Key="Win11SubtleSurfaceColor">#F8F9FA</Color>
    <SolidColorBrush x:Key="Win11SubtleSurfaceBrush" Color="{StaticResource Win11SubtleSurfaceColor}"/>

    <!-- Windows 11 Accent Tokens -->
    <Color x:Key="Win11AccentColor">#0067C0</Color>
    <SolidColorBrush x:Key="Win11AccentBrush" Color="{StaticResource Win11AccentColor}"/>

    <Color x:Key="Win11AccentLightColor">#EBF3FB</Color>
    <SolidColorBrush x:Key="Win11AccentLightBrush" Color="{StaticResource Win11AccentLightColor}"/>

    <!-- Status & Semantic State Brushes -->
    <Color x:Key="Win11SuccessColor">#107C41</Color>
    <SolidColorBrush x:Key="Win11SuccessBrush" Color="{StaticResource Win11SuccessColor}"/>
    <SolidColorBrush x:Key="Win11SuccessBackgroundBrush" Color="#DFF6DD"/>

    <Color x:Key="Win11WarningColor">#CC3600</Color>
    <SolidColorBrush x:Key="Win11WarningBrush" Color="{StaticResource Win11WarningColor}"/>
    <SolidColorBrush x:Key="Win11WarningBackgroundBrush" Color="#FFF4CE"/>

    <Color x:Key="Win11ErrorColor">#C42B1C</Color>
    <SolidColorBrush x:Key="Win11ErrorBrush" Color="{StaticResource Win11ErrorColor}"/>
    <SolidColorBrush x:Key="Win11ErrorBackgroundBrush" Color="#FDE7E9"/>

    <Color x:Key="Win11InfoColor">#005FB8</Color>
    <SolidColorBrush x:Key="Win11InfoBrush" Color="{StaticResource Win11InfoColor}"/>
    <SolidColorBrush x:Key="Win11InfoBackgroundBrush" Color="#E5F3FF"/>

    <!-- Neutral Typography Brushes (WCAG AA Compliant) -->
    <Color x:Key="Win11TextPrimaryColor">#1A1A1A</Color>
    <SolidColorBrush x:Key="Win11TextPrimaryBrush" Color="{StaticResource Win11TextPrimaryColor}"/>

    <Color x:Key="Win11TextSecondaryColor">#5C5C5C</Color>
    <SolidColorBrush x:Key="Win11TextSecondaryBrush" Color="{StaticResource Win11TextSecondaryColor}"/>

    <Color x:Key="Win11TextDisabledColor">#8C8C8C</Color>
    <SolidColorBrush x:Key="Win11TextDisabledBrush" Color="{StaticResource Win11TextDisabledColor}"/>

    <!-- Extended semantic hues (previously hard-coded in views) -->
    <Color x:Key="Win11PurpleColor">#512DA8</Color>
    <SolidColorBrush x:Key="Win11PurpleBrush" Color="{StaticResource Win11PurpleColor}"/>
    <SolidColorBrush x:Key="Win11PurpleBackgroundBrush" Color="#EDE7F6"/>

    <Color x:Key="Win11TealColor">#00695C</Color>
    <SolidColorBrush x:Key="Win11TealBrush" Color="{StaticResource Win11TealColor}"/>
    <SolidColorBrush x:Key="Win11TealBackgroundBrush" Color="#E0F2F1"/>

    <Color x:Key="Win11NeutralColor">#455A64</Color>
    <SolidColorBrush x:Key="Win11NeutralBrush" Color="{StaticResource Win11NeutralColor}"/>
    <SolidColorBrush x:Key="Win11NeutralBackgroundBrush" Color="#ECEFF1"/>

    <!-- Solid fills that carry Win11OnSolidBrush text. Identical in both themes. -->
    <SolidColorBrush x:Key="Win11SuccessSolidBrush" Color="#2E7D32"/>
    <SolidColorBrush x:Key="Win11ErrorSolidBrush" Color="#C62828"/>
    <SolidColorBrush x:Key="Win11WarningSolidBrush" Color="#B3490A"/>
    <SolidColorBrush x:Key="Win11InfoSolidBrush" Color="#005FB8"/>
    <SolidColorBrush x:Key="Win11PurpleSolidBrush" Color="#512DA8"/>
    <SolidColorBrush x:Key="Win11TealSolidBrush" Color="#00695C"/>
    <SolidColorBrush x:Key="Win11NeutralSolidBrush" Color="#5C5C5C"/>
    <SolidColorBrush x:Key="Win11OnSolidBrush" Color="#FFFFFF"/>

    <!-- Monospace diagnostics panel -->
    <SolidColorBrush x:Key="Win11CodeSurfaceBrush" Color="#263238"/>
    <SolidColorBrush x:Key="Win11CodeTextBrush" Color="#ECEFF1"/>

</ResourceDictionary>

