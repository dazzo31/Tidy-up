<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- High Visibility Keyboard Focus Visual Style -->
    <Style x:Key="AccessibleFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2"
                               Stroke="{DynamicResource PrimaryHueMidBrush}"
                               StrokeThickness="2"
                               StrokeDashArray="2 2"
                               RadiusX="4" RadiusY="4"
                               SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accessible Typography Styles (WCAG 2.1 AA Compliant) -->
    <Style x:Key="AccessibleHeadlineTextBlock" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="AccessibleSubtitleTextBlock" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="AccessibleBodyTextBlock" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="AccessibleCaptionTextBlock" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
        <Setter Property="Opacity" Value="0.85"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- High-Contrast Card Border Style -->
    <Style x:Key="AccessibleCard" TargetType="materialDesign:Card" BasedOn="{StaticResource {x:Type materialDesign:Card}}">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
    </Style>

    <!-- Accessible Button Hit-Target Style -->
    <Style x:Key="AccessibleButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
        <Setter Property="KeyboardNavigation.IsTabStop" Value="True"/>
    </Style>

    <Style x:Key="AccessibleOutlinedButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
        <Setter Property="KeyboardNavigation.IsTabStop" Value="True"/>
    </Style>

</ResourceDictionary>

