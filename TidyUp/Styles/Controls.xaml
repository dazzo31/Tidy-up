<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- Card Control Style (Windows 11 Subtle Surface) -->
    <Style x:Key="Win11Card" TargetType="materialDesign:Card" BasedOn="{StaticResource {x:Type materialDesign:Card}}">
        <Setter Property="UniformCornerRadius" Value="6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Win11SubtleBorderBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Win11SurfaceBrush}"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <!-- Standard Primary Button (Accessible High-Target) -->
    <Style x:Key="Win11PrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Background" Value="{DynamicResource Win11AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Win11AccentBrush}"/>
        <Setter Property="KeyboardNavigation.IsTabStop" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
    </Style>

    <!-- Standard Outlined/Secondary Button -->
    <Style x:Key="Win11SecondaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="KeyboardNavigation.IsTabStop" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
    </Style>

    <!-- Pill Status Badge Container -->
    <Style x:Key="Win11StatusBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>

