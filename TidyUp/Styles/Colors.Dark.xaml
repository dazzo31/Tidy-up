<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark overlay for Colors.xaml. Merged AFTER it while the Dark theme is active, so these keys win.
         Every key here must also exist in Colors.xaml (enforced by ThemePaletteTests). -->

    <!-- Windows 11 Fluent Surface & Border Tokens -->
    <Color x:Key="Win11SubtleBorderColor">#3A3A3A</Color>
    <SolidColorBrush x:Key="Win11SubtleBorderBrush" Color="{StaticResource Win11SubtleBorderColor}"/>

    <Color x:Key="Win11SurfaceColor">#202020</Color>
    <SolidColorBrush x:Key="Win11SurfaceBrush" Color="{StaticResource Win11SurfaceColor}"/>

    <Color x:Key="Win11SubtleSurfaceColor">#2B2B2B</Color>
    <SolidColorBrush x:Key="Win11SubtleSurfaceBrush" Color="{StaticResource Win11SubtleSurfaceColor}"/>

    <!-- Windows 11 Accent Tokens -->
    <Color x:Key="Win11AccentColor">#4CC2FF</Color>
    <SolidColorBrush x:Key="Win11AccentBrush" Color="{StaticResource Win11AccentColor}"/>

    <Color x:Key="Win11AccentLightColor">#0F2F45</Color>
    <SolidColorBrush x:Key="Win11AccentLightBrush" Color="{StaticResource Win11AccentLightColor}"/>

    <!-- Status & Semantic State Brushes -->
    <Color x:Key="Win11SuccessColor">#6CCB5F</Color>
    <SolidColorBrush x:Key="Win11SuccessBrush" Color="{StaticResource Win11SuccessColor}"/>
    <SolidColorBrush x:Key="Win11SuccessBackgroundBrush" Color="#16311A"/>

    <Color x:Key="Win11WarningColor">#FFB27A</Color>
    <SolidColorBrush x:Key="Win11WarningBrush" Color="{StaticResource Win11WarningColor}"/>
    <SolidColorBrush x:Key="Win11WarningBackgroundBrush" Color="#3A2410"/>

    <Color x:Key="Win11ErrorColor">#FF99A4</Color>
    <SolidColorBrush x:Key="Win11ErrorBrush" Color="{StaticResource Win11ErrorColor}"/>
    <SolidColorBrush x:Key="Win11ErrorBackgroundBrush" Color="#3D1A1F"/>

    <Color x:Key="Win11InfoColor">#60CDFF</Color>
    <SolidColorBrush x:Key="Win11InfoBrush" Color="{StaticResource Win11InfoColor}"/>
    <SolidColorBrush x:Key="Win11InfoBackgroundBrush" Color="#10303F"/>

    <!-- Neutral Typography Brushes -->
    <Color x:Key="Win11TextPrimaryColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="Win11TextPrimaryBrush" Color="{StaticResource Win11TextPrimaryColor}"/>

    <Color x:Key="Win11TextSecondaryColor">#C8C8C8</Color>
    <SolidColorBrush x:Key="Win11TextSecondaryBrush" Color="{StaticResource Win11TextSecondaryColor}"/>

    <Color x:Key="Win11TextDisabledColor">#9A9A9A</Color>
    <SolidColorBrush x:Key="Win11TextDisabledBrush" Color="{StaticResource Win11TextDisabledColor}"/>

</ResourceDictionary>
